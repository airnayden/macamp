+    // MacAMP patch (backport of v4.2 host-FBO behavior): capture the draw
+    // framebuffer the host bound on entry, so the final composite targets it
+    // instead of a hardcoded 0. Identical to upstream when the host binds 0
+    // (e.g. an NSOpenGLView drawable); also enables offscreen/headless capture
+    // by binding a complete application FBO before calling render.
+    GLint macampHostDrawFbo = 0;
+    glGetIntegerv(GL_DRAW_FRAMEBUFFER_BINDING, &macampHostDrawFbo);
+
     // Update FPS and other timer values.
     m_timeKeeper->UpdateTimers();
 
@@ -166,8 +174,8 @@ void ProjectM::RenderFrame()
