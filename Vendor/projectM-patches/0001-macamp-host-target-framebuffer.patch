-    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, 0);
+    // MacAMP patch: composite to the host-bound draw framebuffer (see capture above).
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, macampHostDrawFbo);
 
     if (m_transition != nullptr && m_transitioningPreset != nullptr)
