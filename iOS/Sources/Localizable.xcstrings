        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Try a different word or check your spelling."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Prueba con otra palabra o revisa la ortografía."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Essayez un autre mot ou vérifiez l'orthographe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prova con un'altra parola o controlla l'ortografia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Попробуйте другое слово или проверьте правописание."
