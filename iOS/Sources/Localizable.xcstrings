    "designSystem.state.offline.message": {
      "comment": "Supporting text for the offline state",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Свържете се отново, за да предавате поточно и да синхронизирате библиотеката си."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle die Verbindung wieder her, um zu streamen und deine Mediathek zu synchronisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnect to stream and sync your library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a conectarte para reproducir en streaming y sincronizar tu biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconnectez-vous pour diffuser et synchroniser votre bibliothèque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Riconnettiti per riprodurre in streaming e sincronizzare la tua libreria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подключитесь снова, чтобы транслировать и синхронизировать медиатеку."
          }
        }
      }
    },
