    "separation.error.cacheCapacityExceeded": {
      "comment": "The rendered audio cannot fit the configured cache limit without removing pinned audio",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The karaoke track doesn't fit the cache limit. Increase the limit in Karaoke settings and try again."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Караоке записът не се побира в лимита на кеша. Увеличете лимита в настройките за караоке и опитайте отново."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Karaoke-Titel passt nicht in den Cache. Erhöhen Sie das Limit in den Karaoke-Einstellungen und versuchen Sie es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La pista de karaoke no cabe en la caché. Aumenta el límite en los ajustes de karaoke e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La piste de karaoké dépasse la limite du cache. Augmentez cette limite dans les réglages du karaoké et réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La traccia karaoke supera il limite della cache. Aumenta il limite nelle impostazioni karaoke e riprova."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Караоке-трек не помещается в кэш. Увеличьте лимит в настройках караоке и повторите попытку."
          }
        }
      }
    },
