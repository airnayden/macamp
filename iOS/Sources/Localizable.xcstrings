    "ios.search.idle.message": {
      "comment": "Body shown before the user types a search query",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Намерете песни, албуми и изпълнители в цялата си колекция."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Finde Titel, Alben und Interpreten in deiner gesamten Sammlung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Find songs, albums and artists across your collection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encuentra canciones, álbumes y artistas en toda tu colección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trouvez des morceaux, albums et artistes dans toute votre collection."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trova brani, album e artisti in tutta la tua raccolta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Находите песни, альбомы и исполнителей во всей коллекции."
          }
        }
      }
    },
