// Cloudflare Worker that serves the static Next.js export (out/) at docs.macamp.si.
// Deployed by .github/workflows/docs.yml on v* tags; locally: npm run deploy.
// No account ID or token lives here: wrangler reads CLOUDFLARE_ACCOUNT_ID and
// CLOUDFLARE_API_TOKEN from the environment (the docs-production secrets in CI).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "macamp-docs",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "docs.macamp.si", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false }
}
