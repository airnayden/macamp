// Cloudflare Worker that serves the static Next.js export (out/) at docs.macamp.si.
// Deployed by .github/workflows/docs-deploy.yml on v* tags; locally: npm run deploy
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "macamp-docs",
  "account_id": "7abb802f0eebeac4d48c5d1731fffcfc",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "docs.macamp.si", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": false }
}
