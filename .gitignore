# Xcode / Tuist generated projects — regenerated by `tuist generate`, never committed
*.xcodeproj
*.xcworkspace

# Build artifacts
.build/
DerivedData/
build/

# Local iOS-portability derived data (`xcodebuild -derivedDataPath .build-ios`).
# Same reason as above: `.build/` matches the directory named exactly `.build`,
# not `.build-ios`.
.build-ios/

# Release artifacts produced by scripts/release.sh — the .dmg, the retained
# dist/releases/ archive that feeds Sparkle's binary deltas, appcast.xml and the
# generated release-notes stubs. All reproducible; none are ever committed.
dist/

# Tuist
.tuist/
Tuist/.build/
Derived/
graph.png
graph.dot

# SwiftPM
.swiftpm/

# Mint (only if a local install path is used)
.mint/

# macOS
.DS_Store

# projectM (Task 31) build trees — regenerated by Vendor/build-projectm.sh.
# The SHIPPING artifacts (dylib, headers, curated presets/textures, licenses)
# live committed under macOS/Vendor/projectM/. These heavy sources do NOT ship.
Vendor/projectM/src/
Vendor/projectM/build/
Vendor/projectM/install/
Vendor/presets-cream/
Vendor/presets-milkdrop-texture-pack/
Vendor/*.log
Vendor/projectM-smoke/smoke
Vendor/projectM-smoke/probe

# Karaoke separation model (feature: karaoke-mode). The converted Core ML model is
# NEVER committed — it is produced by tools/separation/convert_melband_roformer.py and
# bundled at build time via an optional Tuist resource glob (macOS/Project.swift).
# Also excludes any raw checkpoint / .mlpackage that lands anywhere in the tree.
*.mlpackage
macOS/Resources/SeparationModel/

# YouTube-downloader helper binaries (feature: youtube-downloader). The pinned
# yt-dlp_macos / ffmpeg / ffprobe binaries and their generated licence +
# source-offer texts are NEVER committed — they are fetched by
# tools/downloader/fetch-download-tools.sh and bundled at build time via a
# Tuist glob (macOS/Project.swift). The SeparationModel entries above do NOT
# cover this directory.
macOS/Resources/DownloaderTools/

# OhMyOpenCode agent working data (evidence, notepads) — not part of the project
.omo/
# Symlink into the local OhMyOpenCode code-graph cache (points at a home-directory path)
.codegraph

# xcode-build-server (SourceKit-LSP for Xcode targets) — machine-specific DerivedData path
buildServer.json
.build/ios-sim/
*.mlmodelc
SeparationTests/Fixtures/voice_over_music.m4a
.build-l10n-macos/
.build-l10n-ios/
.opencode/
