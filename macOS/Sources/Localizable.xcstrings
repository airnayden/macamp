          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Декодира избраните файлове и показва резултатите от контролната сума и спектъра на всеки от тях."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dekodiert die ausgewählten Dateien und zeigt, was die jeweilige Prüfsumme und das Spektrum ergeben."
          }
        },
        "es": {
          "stringUnit": {
