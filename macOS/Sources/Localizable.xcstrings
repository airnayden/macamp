    "app.downloads.chat.toast.gateGuidance": {
      "comment": "Toast shown when the import gate refused chat-initiated downloads, naming both fixes",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloaded, but not added to your library, so nothing could be added to the playlist. Turn on automatic import in Settings ▸ Downloads, or add that folder in Settings ▸ Library."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Изтеглянето завърши, но записите не са добавени в библиотеката и затова не могат да бъдат добавени към плейлиста. Включете автоматичното импортиране в Настройки ▸ Изтегляния или добавете папката в Настройки ▸ Библиотека."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Download wurde abgeschlossen, aber nicht zur Mediathek hinzugefügt. Daher konnte nichts zur Playlist hinzugefügt werden. Aktiviere den automatischen Import in Einstellungen ▸ Downloads oder füge den Ordner in Einstellungen ▸ Mediathek hinzu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La descarga terminó, pero no se añadió a tu biblioteca, así que no se pudo añadir nada a la lista. Activa la importación automática en Ajustes ▸ Descargas o añade esa carpeta en Ajustes ▸ Biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le téléchargement est terminé, mais n’a pas été ajouté à votre bibliothèque. Rien n’a donc pu être ajouté à la playlist. Activez l’importation automatique dans Réglages ▸ Téléchargements, ou ajoutez ce dossier dans Réglages ▸ Bibliothèque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Download completato, ma non aggiunto alla libreria, quindi non è stato possibile aggiungere nulla alla playlist. Attiva l’importazione automatica in Impostazioni ▸ Download oppure aggiungi la cartella in Impostazioni ▸ Libreria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Загрузка завершена, но треки не добавлены в медиатеку, поэтому добавить их в плейлист не удалось. Включите автоматический импорт в Настройки ▸ Загрузки или добавьте эту папку в Настройки ▸ Медиатека."
          }
        }
      }
    },
