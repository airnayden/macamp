    "app.preferences.intelligence.webSuggestions.caption": {
      "comment": "Caption explaining what the web-suggestions feature adds to the assistant",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lets the assistant recommend songs you do not own yet, and attach a link to listen to each one."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Позволява на асистента да препоръчва песни, които още не притежавате, и да добавя връзка за слушане към всяка от тях."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erlaubt dem Assistenten, Songs zu empfehlen, die du noch nicht besitzt, und jeweils einen Link zum Anhören anzufügen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permite que el asistente recomiende canciones que aún no tienes y añada un enlace para escuchar cada una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Permet à l’assistant de recommander des morceaux que vous ne possédez pas encore et de joindre un lien pour écouter chacun d’eux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Consente all’assistente di consigliare brani che non possiedi ancora e di aggiungere un link per ascoltare ciascuno."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Позволяет ассистенту рекомендовать песни, которых у вас ещё нет, и добавлять ссылку для прослушивания каждой из них."
          }
        }
      }
    },
    "app.preferences.intelligence.webSuggestions.cloudOnly.caption": {
      "comment": "Caption stating the feature is inert on the on-device assistant tier",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only used while a cloud provider is answering. The on-device assistant never looks anything up."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Използва се само когато отговаря облачен доставчик. Асистентът на устройството никога не търси в интернет."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wird nur verwendet, wenn ein Cloud-Anbieter antwortet. Der Assistent auf dem Gerät führt niemals Online-Suchen aus."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Solo se usa cuando responde un proveedor en la nube. El asistente del dispositivo nunca hace búsquedas en línea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utilisé uniquement lorsqu’un fournisseur cloud répond. L’assistant sur l’appareil n’effectue jamais de recherches en ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usato solo quando risponde un fornitore cloud. L’assistente sul dispositivo non effettua mai ricerche online."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Используется только при ответах облачного провайдера. Ассистент на устройстве никогда ничего не ищет в интернете."
          }
        }
      }
    },
