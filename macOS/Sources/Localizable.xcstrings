    "app.preferences.intelligence.external.needsIntelligence": {
      "comment": "Caption explaining that the master Intelligence switch gates external access",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Включете функциите за интелигентност, за да разрешите външен достъп."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
