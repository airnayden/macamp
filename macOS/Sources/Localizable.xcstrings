    "app.preferences.intelligence.external.consent.cancel.help": {
      "comment": "Tooltip of the button declining the external-access disclosure",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставя външния достъп изключен. Нищо извън MacAMP не може да достигне библиотеката ви."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt den externen Zugriff aus. Nichts außerhalb von MacAMP erreicht deine Mediathek."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave external access off. Nothing outside MacAMP can reach your library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja el acceso externo desactivado. Nada fuera de MacAMP puede acceder a tu biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisse l’accès externe désactivé. Rien en dehors de MacAMP n’atteint votre bibliothèque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia disattivo l’accesso esterno. Nulla al di fuori di MacAMP raggiunge la tua libreria."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "Leave external access off. Nothing outside MacAMP can reach your library."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставить внешний доступ выключенным. Ничто вне MacAMP не сможет обратиться к вашей медиатеке."
          }
        }
      }
    },
    "app.preferences.intelligence.external.consent.control.heading": {
      "comment": "Heading of the disclosure block that separates reading the library from controlling playback",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Управлението на музиката ви е отделен превключвател:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Steuerung deiner Musik ist ein separater Schalter:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlling your music is a separate switch:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlar tu música es un interruptor aparte:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Contrôler votre musique est un réglage distinct :"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Controllare la tua musica è un’opzione separata:"
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "translated",
            "value": "Controlling your music is a separate switch:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управление музыкой — отдельный переключатель:"
          }
        }
      }
    },
    "app.preferences.intelligence.external.consent.control.item": {
      "comment": "Disclosure line stating that accepting external access does not grant playback control",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Приемането позволява на инструментите да ЧЕТАТ библиотеката ви. Не им позволява да докосват плейъра."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit dem Akzeptieren dürfen Werkzeuge deine Mediathek LESEN. Den Player anfassen dürfen sie damit nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepting this lets tools READ your library. It does not let them touch the player."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceptar permite que las herramientas LEAN tu biblioteca. No les permite tocar el reproductor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepter permet aux outils de LIRE votre bibliothèque. Cela ne leur permet pas de toucher au lecteur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accettare consente agli strumenti di LEGGERE la tua libreria. Non consente loro di toccare il lettore."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepting this lets tools READ your library. It does not let them touch the player."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Согласие позволяет инструментам ЧИТАТЬ вашу медиатеку. Трогать плеер оно не разрешает."
          }
        }
      }
    },
    "app.preferences.intelligence.external.consent.control.optIn": {
      "comment": "Disclosure line naming the separate opt-in required before an external program may control playback",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пускането, паузата и прескачането на музиката ви изискват втори превключвател в този панел, който остава изключен, докато не го включите."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Starten, Pausieren und Überspringen deiner Musik erfordert einen zweiten Schalter in diesem Bereich, der aus bleibt, bis du ihn einschaltest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting, pausing and skipping your music needs a second switch in this pane, which stays off until you turn it on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniciar, pausar y saltar tu música requiere un segundo interruptor en este panel, que sigue desactivado hasta que lo actives."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lancer, mettre en pause et passer votre musique nécessite un second réglage dans ce volet, qui reste désactivé tant que vous ne l’activez pas."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avviare, mettere in pausa e saltare la tua musica richiede una seconda opzione in questo pannello, che resta disattiva finché non la attivi."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting, pausing and skipping your music needs a second switch in this pane, which stays off until you turn it on."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запуск, пауза и пропуск музыки требуют второго переключателя в этой панели; он выключен, пока вы его не включите."
          }
        }
      }
    },
    "app.preferences.intelligence.external.consent.exclusions": {
      "comment": "States what an external program never receives",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Никога не се изпращат аудио, имена или местоположения на файлове, обложки и текстове."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden nie Audio, Dateinamen oder Speicherorte, Cover oder Songtexte gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No audio, no file names or locations on disk, no artwork and no lyrics are ever sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca se envían audio, nombres o ubicaciones de archivos, ilustraciones ni letras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun contenu audio, nom ou emplacement de fichier, illustration ni parole n’est jamais envoyé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non vengono mai inviati audio, nomi o percorsi dei file, copertine o testi."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "No audio, no file names or locations on disk, no artwork and no lyrics are ever sent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Аудио, имена и пути файлов, обложки и тексты песен никогда не отправляются."
          }
        }
      }
    },
    "app.preferences.intelligence.external.consent.identity": {
      "comment": "States plainly that connected programs are not identified or individually approved",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP не може да разбере коя програма е свързана — докато това е включено, всяка програма, работеща под вашия профил, може."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP kann nicht erkennen, welches Programm verbunden ist — solange dies aktiv ist, kann es jedes Programm unter deinem Benutzer."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP cannot tell which program is connected — any program running as you can, while this is on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP no puede saber qué programa está conectado: mientras esto esté activo, puede hacerlo cualquier programa ejecutado por ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP ne peut pas savoir quel programme est connecté — tant que ceci est actif, tout programme lancé par vous le peut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP non può sapere quale programma sia connesso: finché è attivo, può farlo qualsiasi programma eseguito da te."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "MacAMP cannot tell which program is connected — any program running as you can, while this is on."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP не может определить, какая программа подключена — пока это включено, подключиться может любая программа от вашего имени."
          }
        }
      }
    },
    "app.preferences.intelligence.external.consent.lead": {
      "comment": "Lead sentence of the external-access disclosure",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Докато това е включено, ИИ инструменти на този Mac ще могат да питат MacAMP за музиката ви."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange dies aktiv ist, können KI-Tools auf diesem Mac MacAMP nach deiner Musik fragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "AI tools running on this Mac will be able to ask MacAMP about your music while this is on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras esto esté activo, las herramientas de IA de este Mac podrán preguntar a MacAMP por tu música."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que cette option est active, les outils d’IA de ce Mac pourront interroger MacAMP sur votre musique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finché è attivo, gli strumenti IA su questo Mac potranno interrogare MacAMP sulla tua musica."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "AI tools running on this Mac will be able to ask MacAMP about your music while this is on."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока это включено, ИИ-инструменты на этом Mac смогут спрашивать MacAMP о вашей музыке."
          }
        }
      }
    },
    "app.preferences.intelligence.external.consent.loopback": {
      "comment": "States that the local server is bound to loopback and unreachable from the network",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Връзката е ограничена до този Mac (127.0.0.1, порт %@) и никога не е достъпна от мрежата ви."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Verbindung ist auf diesen Mac beschränkt (127.0.0.1, Port %@) und nie aus deinem Netzwerk erreichbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The connection is limited to this Mac (127.0.0.1, port %@) and is never reachable from your network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión se limita a este Mac (127.0.0.1, puerto %@) y nunca es accesible desde tu red."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion est limitée à ce Mac (127.0.0.1, port %@) et n’est jamais accessible depuis votre réseau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione è limitata a questo Mac (127.0.0.1, porta %@) e non è mai raggiungibile dalla tua rete."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "The connection is limited to this Mac (127.0.0.1, port %@) and is never reachable from your network."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Соединение ограничено этим Mac (127.0.0.1, порт %@) и никогда не доступно из вашей сети."
          }
        }
      }
    },
    "app.preferences.intelligence.external.consent.payload.facets": {
