    "app.preferences.karaoke.quality.caption": {
      "comment": "Explains that the karaoke quality choice only affects newly rendered instrumentals",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Важи за новосъздадените караоке версии. Вече кешираните инструментални версии с друго качество не се променят."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gilt für neu erstellte Karaoke-Versionen. Bereits mit anderer Qualität zwischengespeicherte Instrumentalversionen bleiben unverändert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to newly created karaoke versions. Instrumentals already cached at another quality are unaffected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se aplica a las nuevas versiones de karaoke. No afecta a las versiones instrumentales ya guardadas en la caché con otra calidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "S’applique aux nouvelles versions karaoké. Les versions instrumentales déjà en cache dans une autre qualité restent inchangées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si applica alle nuove versioni karaoke. Le versioni strumentali già nella cache con una qualità diversa restano invariate."
          }
