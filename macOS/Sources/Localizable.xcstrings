      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тази папка се застъпва с кеша за караоке. Изберете папка извън него."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Ordner überschneidet sich mit dem Karaoke-Cache. Wähle einen Ordner außerhalb davon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That folder overlaps the karaoke cache. Choose a folder outside it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esa carpeta se solapa con la caché de karaoke. Elige una carpeta fuera de ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce dossier chevauche le cache karaoké. Choisissez un dossier en dehors de celui-ci."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quella cartella si sovrappone alla cache del karaoke. Scegli una cartella al di fuori."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "That folder overlaps the karaoke cache. Choose a folder outside it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта папка пересекается с кэшем караоке. Выберите папку вне его."
          }
        }
      }
    },
    "app.preferences.downloads.destination.rejected.notWritable": {
      "comment": "Shown when the app's own write probe into a chosen downloads folder was refused",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP не може да пише в тази папка. Изберете друга или дайте достъп в Системни настройки ▸ Поверителност и сигурност ▸ Файлове и папки."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP kann nicht in diesen Ordner schreiben. Wähle einen anderen oder erteile Zugriff unter Systemeinstellungen ▸ Datenschutz & Sicherheit ▸ Dateien und Ordner."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP can't write to that folder. Choose a different one, or grant access in System Settings ▸ Privacy & Security ▸ Files and Folders."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP no puede escribir en esa carpeta. Elige otra o concede acceso en Ajustes del Sistema ▸ Privacidad y seguridad ▸ Archivos y carpetas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP ne peut pas écrire dans ce dossier. Choisissez-en un autre ou accordez l’accès dans Réglages Système ▸ Confidentialité et sécurité ▸ Fichiers et dossiers."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP non può scrivere in quella cartella. Scegline un’altra oppure concedi l’accesso in Impostazioni di Sistema ▸ Privacy e sicurezza ▸ File e cartelle."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "MacAMP can't write to that folder. Choose a different one, or grant access in System Settings ▸ Privacy & Security ▸ Files and Folders."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP не может записывать в эту папку. Выберите другую или предоставьте доступ в разделе «Системные настройки» ▸ «Конфиденциальность и безопасность» ▸ «Файлы и папки»."
          }
        }
      }
    },
