    "app.preferences.downloads.format.caption": {
      "comment": "Explains that format and quality changes reach future downloads only",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Важи за изтеглянията, които добавите отсега нататък. Вече чакащите или изтеглящите се запазват настройките, с които са започнали."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gilt für Downloads, die du ab jetzt hinzufügst. Bereits eingereihte oder laufende Downloads behalten die Einstellungen, mit denen sie begonnen haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Applies to downloads you add from now on. Items already queued or downloading keep the settings they started with."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se aplica a las descargas que añadas a partir de ahora. Los elementos ya en cola o descargándose conservan los ajustes con los que empezaron."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’applique aux téléchargements que vous ajouterez désormais. Les éléments déjà en file d’attente ou en cours conservent les réglages avec lesquels ils ont démarré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vale per i download che aggiungi da ora in poi. Gli elementi già in coda o in corso mantengono le impostazioni con cui sono partiti."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "Applies to downloads you add from now on. Items already queued or downloading keep the settings they started with."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Применяется к загрузкам, добавленным с этого момента. Уже стоящие в очереди или загружающиеся сохраняют настройки, с которыми начались."
          }
        }
      }
    },
