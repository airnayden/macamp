          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn Intelligence features on to allow external access."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa las funciones de Inteligencia para permitir el acceso externo."
          }
        },
        "fr": {
          "stringUnit": {
