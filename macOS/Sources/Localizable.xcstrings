    },
    "app.preferences.output.device.missing": {
      "comment": "Notice shown when the chosen output device is unplugged and playback fell back to the system default",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That device isn't connected, so sound is going to the system default. Plug it back in and MacAMP will return to it."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Това устройство не е свързано, затова звукът се възпроизвежда през системното устройство по подразбиране. Свържете го отново и MacAMP ще се върне към него."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieses Gerät ist nicht verbunden. Der Ton wird daher über das Standardgerät des Systems ausgegeben. Schließe es wieder an, und MacAMP wechselt zurück."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ese dispositivo no está conectado, por lo que el sonido se envía al predeterminado del sistema. Vuelve a conectarlo y MacAMP lo usará de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce périphérique n’est pas connecté : le son passe donc par le périphérique par défaut du système. Rebranchez-le et MacAMP l’utilisera à nouveau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Il dispositivo non è collegato, quindi l’audio viene inviato a quello predefinito di sistema. Ricollegalo e MacAMP tornerà a usarlo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Это устройство не подключено, поэтому звук выводится через системное устройство по умолчанию. Подключите его снова, и MacAMP вернётся к нему."
          }
        }
      }
    },
