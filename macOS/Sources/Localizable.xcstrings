            "state": "translated",
            "value": "Permitirles también reproducir y pausar tu música"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autoriser aussi à lire et mettre en pause votre musique"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti loro anche di riprodurre e mettere in pausa la tua musica"
          }
