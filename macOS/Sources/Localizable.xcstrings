    "app.preferences.intelligence.mcp.consent.cancel.help": {
      "comment": "Tooltip of the button declining the MCP server trust disclosure",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставете този сървър изключен. Нищо не се запазва и нищо не се свързва."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Server ausgeschaltet lassen. Nichts wird gesichert und nichts kontaktiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave this server switched off. Nothing is saved and nothing is contacted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja este servidor desactivado. No se guarda nada ni se contacta nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laissez ce serveur désactivé. Rien n’est enregistré ni contacté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia questo server disattivato. Nulla viene salvato né contattato."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "Leave this server switched off. Nothing is saved and nothing is contacted."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оставить сервер выключенным. Ничего не сохраняется и никуда не отправляется."
          }
        }
      }
    },
    "app.preferences.intelligence.mcp.consent.command": {
      "comment": "Disclosure item naming the local program a command-backed MCP server would start",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този е команден сървър: включването му позволява на MacAMP да изпълни %@ на вашия Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser ist ein Befehls-Server: Aktivieren erlaubt MacAMP, %@ auf deinem Mac auszuführen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This one is a command server: enabling it lets MacAMP run %@ on your Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este es un servidor de comandos: activarlo permite que MacAMP ejecute %@ en tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Celui-ci est un serveur de commande : l’activer permet à MacAMP d’exécuter %@ sur votre Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo è un server a comando: attivarlo consente a MacAMP di eseguire %@ sul tuo Mac."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "This one is a command server: enabling it lets MacAMP run %@ on your Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это командный сервер: его включение позволит MacAMP запустить %@ на вашем Mac."
          }
        }
      }
    },
    "app.preferences.intelligence.mcp.consent.heading": {
      "comment": "Heading above the itemised risks of enabling an external MCP server",
      "extractionState": "manual",
      "localizations": {
        "bg": {
