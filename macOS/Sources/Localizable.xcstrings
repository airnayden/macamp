    "app.preferences.downloads.autoImport.offCaption": {
      "comment": "Caption shown while automatic import is off, naming both ways to reach the files",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изтеглянията пак се запазват в папката по-горе, но няма да се появят в библиотеката ви. Включете тази настройка или добавете папката от Настройки ▸ Библиотека."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads werden weiterhin im Ordner oben gesichert, erscheinen aber nicht in deiner Mediathek. Aktiviere diese Option oder füge den Ordner unter Einstellungen ▸ Mediathek hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads are still saved to the folder above, but they will not appear in your library. Turn this on, or add that folder in Settings ▸ Library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las descargas se siguen guardando en la carpeta de arriba, pero no aparecerán en tu biblioteca. Activa esta opción o añade esa carpeta en Ajustes ▸ Biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les téléchargements sont toujours enregistrés dans le dossier ci-dessus, mais ils n’apparaîtront pas dans votre bibliothèque. Activez cette option ou ajoutez ce dossier dans Réglages ▸ Bibliothèque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I download vengono comunque salvati nella cartella qui sopra, ma non compariranno nella tua libreria. Attiva questa opzione oppure aggiungi quella cartella in Impostazioni ▸ Libreria."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "Downloads are still saved to the folder above, but they will not appear in your library. Turn this on, or add that folder in Settings ▸ Library."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Загрузки по-прежнему сохраняются в папку выше, но не появятся в вашей медиатеке. Включите этот параметр или добавьте эту папку в разделе «Настройки» ▸ «Медиатека»."
          }
        }
      }
    },
