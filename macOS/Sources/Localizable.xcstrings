        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forget this download. The file itself is not deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvida esta descarga. El archivo en sí no se elimina."
