    "app.ai.action.notEnoughAnalyzed": {
      "comment": "Toast shown when too few tracks in this playlist carry audio analysis for an energy arc",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Все още няма достатъчно анализирани песни в този плейлист — стартирайте „Анализиране“ в Настройки ▸ Intelligence"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Von dieser Playlist wurde noch nicht genug analysiert – starte „Analysieren“ unter Einstellungen ▸ Intelligence"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough of this playlist has been analyzed yet — run Analyze in Settings ▸ Intelligence"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
