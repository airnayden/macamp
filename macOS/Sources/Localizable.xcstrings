          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Аудиодвижок отклонил эти фильтры. Прежние настройки остаются в силе."
          }
        }
      }
    },
    "app.eq.parametric.error.malformedLine": {
      "comment": "Error shown when a line of an AutoEq profile does not match the expected grammar",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Line %lld isn’t in AutoEq’s format. MacAMP stopped rather than guess what it meant."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ред %lld не е във формата на AutoEq. MacAMP спря, вместо да предполага какво означава."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Zeile %lld entspricht nicht dem AutoEq-Format. MacAMP hat abgebrochen, statt den Inhalt zu erraten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La línea %lld no tiene el formato de AutoEq. MacAMP se detuvo en lugar de adivinar su significado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La ligne %lld ne respecte pas le format AutoEq. MacAMP s’est arrêté plutôt que d’en deviner le sens."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La riga %lld non rispetta il formato AutoEq. MacAMP si è fermato invece di tentare di interpretarla."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Строка %lld не соответствует формату AutoEq. MacAMP остановился, чтобы не угадывать её смысл."
          }
        }
      }
    },
