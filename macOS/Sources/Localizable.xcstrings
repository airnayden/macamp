    "app.downloads.history.delete.help": {
      "comment": "Tooltip for the Delete Entry action, stating plainly that only the log row goes and the audio file on disk survives",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
