    "app.preferences.intelligence.mcp.remove.help": {
      "comment": "Tooltip of the button that removes one MCP server",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Забравете този сървър, изтрийте запазените данни и оттеглете разрешението си."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Server vergessen, seine gesicherten Zugangsdaten löschen und die Erlaubnis zurückziehen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forget this server, delete its saved credentials, and withdraw your permission."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Olvida este servidor, borra sus credenciales guardadas y retira tu permiso."
          }
        },
        "fr": {
