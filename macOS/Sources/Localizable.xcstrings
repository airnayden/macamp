    "app.ai.action.moreLikeThisHelp": {
      "comment": "Tooltip on the More Like This context-menu item",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Предложете плейлист около тази песен, за преглед преди запазване"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Playlist rund um diesen Titel vorschlagen – vor dem Sichern prüfbar"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggest a playlist built around this track, to review before it is saved"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugiere una lista creada en torno a esta pista, para revisarla antes de guardar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proposer une playlist construite autour de ce titre, à vérifier avant enregistrement"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggerisci una playlist costruita attorno a questo brano, da rivedere prima di salvare"
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "Suggest a playlist built around this track, to review before it is saved"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предложить плейлист вокруг этого трека — с проверкой перед сохранением"
          }
        }
      }
    },
    "app.ai.action.moreLikeThisUnavailable": {
      "comment": "Why More Like This is greyed out for a track whose file is gone",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Файлът на тази песен липсва, затова не може да бъде основа за плейлист"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Datei dieses Titels fehlt, er kann keine Playlist starten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This track's file is missing, so it cannot seed a playlist"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Falta el archivo de esta pista, así que no puede originar una lista"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier de ce titre est introuvable : il ne peut pas amorcer une playlist"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file di questo brano manca, quindi non può avviare una playlist"
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "This track's file is missing, so it cannot seed a playlist"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Файл этого трека отсутствует, поэтому он не может стать основой плейлиста"
          }
        }
      }
    },
