    "app.assistant.preview.failurePlaylistChanged": {
      "comment": "A stale playlist proposal was refused without changing membership",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This playlist changed after the preview. Generate a new suggestion and try again."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този плейлист беше променен след прегледа. Генерирайте ново предложение и опитайте отново."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
