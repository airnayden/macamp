        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The assistant couldn't answer that. Try again, or ask in a different way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El asistente no ha podido responder. Inténtalo de nuevo o pregunta de otra forma."
