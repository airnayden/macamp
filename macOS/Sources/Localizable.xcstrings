    "app.externalOAuth.chatGPT.cancel.help": {
      "comment": "Tooltip for the button that abandons a ChatGPT sign-in attempt",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Прекратява този опит за влизане и спира изчакването на отговор от браузъра"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Bricht diesen Anmeldeversuch ab und wartet nicht länger auf den Browser"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Abandons this sign-in attempt and stops listening for the browser"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abandona este intento de inicio de sesión y deja de esperar la respuesta del navegador"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abandonne cette tentative de connexion et cesse d’attendre la réponse du navigateur"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Annulla questo tentativo di accesso e smette di attendere la risposta del browser"
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "Abandons this sign-in attempt and stops listening for the browser"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Прерывает эту попытку входа и прекращает ожидание ответа от браузера"
          }
        }
      }
    },
    "app.externalOAuth.chatGPT.caption": {
      "comment": "Explains what signing in with a ChatGPT subscription does and where the session is stored",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Използвайте своя абонамент за ChatGPT вместо API ключ. Одобрението се извършва в браузъра и се връща автоматично към този Mac; сесията се съхранява в Keychain, а паролата ви никога не се вижда или запазва."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verwende dein ChatGPT-Abo anstelle eines API-Schlüssels. Die Freigabe erfolgt im Browser und wird automatisch an diesen Mac zurückgesendet. Die Sitzung wird in deinem Schlüsselbund gespeichert; dein Passwort wird niemals eingesehen oder gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your ChatGPT plan instead of an API key. Approval happens in your browser and comes back to this Mac automatically; the session is stored in your Keychain and your password is never seen or saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usa tu plan de ChatGPT en lugar de una clave de API. La autorización se realiza en el navegador y vuelve automáticamente a este Mac; la sesión se guarda en tu llavero y tu contraseña nunca se ve ni se guarda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utilisez votre abonnement ChatGPT au lieu d’une clé API. L’autorisation se fait dans votre navigateur et revient automatiquement à ce Mac ; la session est conservée dans votre trousseau et votre mot de passe n’est jamais consulté ni enregistré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usa il tuo piano ChatGPT al posto di una chiave API. L’autorizzazione avviene nel browser e torna automaticamente a questo Mac; la sessione viene conservata nel portachiavi e la password non viene mai vista o salvata."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "Use your ChatGPT plan instead of an API key. Approval happens in your browser and comes back to this Mac automatically; the session is stored in your Keychain and your password is never seen or saved."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Используйте подписку ChatGPT вместо API-ключа. Разрешение выдаётся в браузере и автоматически возвращается на этот Mac; сессия хранится в связке ключей, а ваш пароль никогда не просматривается и не сохраняется."
          }
        }
      }
    },
    "app.externalOAuth.chatGPT.failure.portUnavailable": {
      "comment": "Error shown when neither loopback port used by the ChatGPT sign-in redirect could be opened",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Друго приложение използва порта, на който ChatGPT връща одобрението. Прекратете текущо влизане в Codex и опитайте отново."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine andere App verwendet den Port, an den ChatGPT die Freigabe zurücksendet. Beende laufende Codex-Anmeldungen und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another app is using the port ChatGPT sends approval back to. Quit any running Codex sign-in and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Otra app usa el puerto al que ChatGPT devuelve la autorización. Cierra cualquier inicio de sesión de Codex en curso y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une autre app utilise le port auquel ChatGPT renvoie l’autorisation. Fermez toute connexion Codex en cours, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un’altra app usa la porta a cui ChatGPT restituisce l’autorizzazione. Interrompi eventuali accessi a Codex in corso e riprova."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "Another app is using the port ChatGPT sends approval back to. Quit any running Codex sign-in and try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Другое приложение использует порт, на который ChatGPT возвращает разрешение. Завершите текущие попытки входа в Codex и повторите попытку."
          }
        }
      }
    },
    "app.externalOAuth.chatGPT.failure.rejected": {
