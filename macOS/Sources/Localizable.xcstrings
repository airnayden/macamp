    "app.tags.readOnly.message": {
      "comment": "Explanation shown when the selected file(s) cannot be written on macOS",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These files can’t be written — they may be missing, locked, or in a format MacAMP can’t tag."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Тези файлове не могат да бъдат променени. Възможно е да липсват, да са заключени или да са във формат, чиито етикети MacAMP не може да редактира."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese Dateien können nicht beschrieben werden. Sie fehlen möglicherweise, sind gesperrt oder haben ein Format, dessen Tags MacAMP nicht bearbeiten kann."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se puede escribir en estos archivos. Puede que falten, estén bloqueados o tengan un formato cuyas etiquetas MacAMP no puede editar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossible de modifier ces fichiers. Ils sont peut-être introuvables, verrouillés ou dans un format dont MacAMP ne peut pas modifier les tags."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non è possibile modificare questi file. Potrebbero essere mancanti, bloccati o in un formato di cui MacAMP non può modificare i tag."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Эти файлы нельзя изменить. Возможно, они отсутствуют, заблокированы или имеют формат, теги которого MacAMP не может редактировать."
          }
        }
      }
    },
