    "app.eq.parametric.shelfApproximated": {
      "comment": "Notice shown when a shelf filter's Q deviates far enough that the system equalizer only approximates its slope",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some shelf filters use a Q macOS cannot reproduce exactly, so their slope is approximated. Their frequency and gain are exact."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Някои шелф филтри използват Q, което macOS не може да възпроизведе точно, затова наклонът им е приблизителен. Честотата и усилването им са точни."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Einige Shelving-Filter verwenden einen Q-Wert, den macOS nicht exakt wiedergeben kann. Ihre Flankensteilheit wird daher angenähert. Frequenz und Verstärkung sind exakt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Algunos filtros de estantería usan un valor Q que macOS no puede reproducir con exactitud, por lo que su pendiente es aproximada. La frecuencia y la ganancia sí son exactas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Certains filtres en plateau utilisent un facteur Q que macOS ne peut pas reproduire exactement. Leur pente est donc approximative, mais leur fréquence et leur gain sont exacts."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Alcuni filtri shelving usano un valore Q che macOS non può riprodurre esattamente, quindi la loro pendenza è approssimata. Frequenza e guadagno sono esatti."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Некоторые шельфовые фильтры используют значение Q, которое macOS не может воспроизвести точно, поэтому их крутизна приблизительна. Частота и усиление воспроизводятся точно."
          }
        }
      }
    },
