    "app.preferences.intelligence.config.optionalKey.caption": {
      "comment": "Caption under the optional API key field explaining when it is needed and where it is stored",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Оставете празно за сървър, който управлявате сами. Ollama Cloud изисква ключ, който се съхранява в ключодържателя за вход."
