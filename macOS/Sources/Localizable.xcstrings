          }
        }
      }
    },
    "app.preferences.downloads.engine.busy.caption": {
      "comment": "Explains why the engine update button is disabled during a download",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Модулът не може да бъде заменен, докато тече изтегляне. Опитайте отново, след като опашката приключи."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Engine kann nicht ersetzt werden, während ein Download läuft. Versuche es erneut, sobald die Warteschlange fertig ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The engine can't be replaced while a download is running. Try again once the queue finishes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El motor no se puede sustituir mientras hay una descarga en curso. Inténtalo de nuevo cuando termine la cola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur ne peut pas être remplacé pendant un téléchargement. Réessayez une fois la file d’attente terminée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il motore non può essere sostituito mentre è in corso un download. Riprova quando la coda sarà finita."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "The engine can't be replaced while a download is running. Try again once the queue finishes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Движок нельзя заменить, пока идёт загрузка. Повторите попытку, когда очередь завершится."
          }
        }
      }
    },
