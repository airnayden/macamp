    "app.assistant.chat.download.importOff": {
      "comment": "Warning that downloaded songs will not enter the library with the current settings",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads won’t appear in your library until you turn on \"Add finished downloads to my library\" in Settings ▸ Downloads, or add your downloads folder to your library."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Изтеглените песни няма да се появят в библиотеката, докато не включите „Добавяне на завършените изтегляния в библиотеката“ в Настройки ▸ Изтегляния или не добавите папката за изтегляния в библиотеката."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Downloads erscheinen erst in deiner Mediathek, wenn du in Einstellungen ▸ Downloads die Option „Abgeschlossene Downloads zu meiner Mediathek hinzufügen“ aktivierst oder deinen Downloadordner zur Mediathek hinzufügst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las descargas no aparecerán en tu biblioteca hasta que actives «Añadir las descargas terminadas a mi biblioteca» en Ajustes ▸ Descargas o añadas la carpeta de descargas a tu biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les téléchargements n’apparaîtront dans votre bibliothèque que si vous activez « Ajouter les téléchargements terminés à ma bibliothèque » dans Réglages ▸ Téléchargements, ou si vous ajoutez votre dossier de téléchargements à la bibliothèque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I download non appariranno nella libreria finché non attivi “Aggiungi i download completati alla mia libreria” in Impostazioni ▸ Download o aggiungi la cartella dei download alla libreria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Загруженные песни не появятся в медиатеке, пока вы не включите «Добавлять завершённые загрузки в медиатеку» в Настройки ▸ Загрузки или не добавите папку загрузок в медиатеку."
          }
        }
      }
    },
