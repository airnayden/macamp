    "app.preferences.intelligence.webSuggestions.consent.videoItem": {
      "comment": "Disclosure row naming the video service that receives song titles and artists",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Those same titles and artists are sent to %@ to find and verify a link that actually plays."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Същите заглавия и изпълнители се изпращат до %@, за да се намери и провери връзка, която наистина възпроизвежда музика."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieselben Titel und Interpreten werden an %@ gesendet, um einen tatsächlich abspielbaren Link zu finden und zu prüfen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esos mismos títulos y artistas se envían a %@ para encontrar y verificar un enlace que realmente se reproduzca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ces mêmes titres et artistes sont envoyés à %@ pour trouver et vérifier un lien qui permet réellement la lecture."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gli stessi titoli e artisti vengono inviati a %@ per trovare e verificare un link che consenta davvero la riproduzione."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Те же названия и исполнители отправляются в %@, чтобы найти и проверить ссылку, которая действительно позволяет воспроизведение."
          }
        }
      }
    },
    "app.preferences.intelligence.webSuggestions.keyFailed": {
      "comment": "Caption shown when storing or removing an optional API key did not settle",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That key could not be saved. Check that your Keychain is unlocked, then try again."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ключът не може да бъде запазен. Проверете дали Keychain е отключен и опитайте отново."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Der Schlüssel konnte nicht gespeichert werden. Prüfe, ob dein Schlüsselbund entsperrt ist, und versuche es erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No se pudo guardar esa clave. Comprueba que tu llavero esté desbloqueado y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette clé n’a pas pu être enregistrée. Vérifiez que votre trousseau est déverrouillé, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Impossibile salvare la chiave. Verifica che il portachiavi sia sbloccato, poi riprova."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Не удалось сохранить ключ. Убедитесь, что связка ключей разблокирована, и повторите попытку."
          }
        }
      }
    },
    "app.preferences.intelligence.webSuggestions.keys.absent": {
      "comment": "Caption shown beside a key field when no key is stored",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No key saved — the rate-limited keyless mode is in use."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Няма запазен ключ — използва се режимът без ключ с ограничена честота на заявките."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Kein Schlüssel gespeichert – der schlüssellose Modus mit begrenzter Anfragerate wird verwendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "No hay ninguna clave guardada; se usa el modo sin clave con un límite de solicitudes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Aucune clé enregistrée — le mode sans clé à fréquence de requêtes limitée est utilisé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nessuna chiave salvata: è in uso la modalità senza chiave con richieste limitate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ключ не сохранён — используется режим без ключа с ограниченной частотой запросов."
          }
        }
      }
    },
    "app.preferences.intelligence.webSuggestions.keys.caption": {
      "comment": "Caption explaining that the two API keys are optional and only raise rate limits",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both services work without a key, at a limited rate. Adding your own key raises that limit; it changes nothing about what is sent. Keys are kept in your Keychain."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "И двете услуги работят без ключ с ограничена честота на заявките. Собственият ключ увеличава този лимит, без да променя изпращаните данни. Ключовете се съхраняват в Keychain."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Beide Dienste funktionieren ohne Schlüssel mit begrenzter Anfragerate. Ein eigener Schlüssel erhöht dieses Limit, ändert aber nichts an den gesendeten Daten. Schlüssel werden in deinem Schlüsselbund gespeichert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ambos servicios funcionan sin clave con un límite de solicitudes. Añadir tu propia clave aumenta ese límite sin cambiar los datos que se envían. Las claves se guardan en tu llavero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les deux services fonctionnent sans clé avec une fréquence de requêtes limitée. Ajouter votre propre clé augmente cette limite sans modifier les données envoyées. Les clés sont conservées dans votre trousseau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Entrambi i servizi funzionano senza chiave con un limite di richieste. Una chiave personale aumenta tale limite senza cambiare i dati inviati. Le chiavi sono conservate nel portachiavi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Оба сервиса работают без ключа с ограниченной частотой запросов. Собственный ключ повышает этот лимит, не меняя состав отправляемых данных. Ключи хранятся в связке ключей."
          }
        }
      }
    },
