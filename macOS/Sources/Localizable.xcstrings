    "app.signalPath.badge.src.subtitle": {
      "comment": "Explanation shown beneath the sample-rate-conversion badge",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The source rate and the device clock differ, so the audio is being resampled."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Честотите на източника и устройството се различават, затова звукът се преобразува към друга честота на дискретизация."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Die Abtastrate der Quelle und der Gerätetakt unterscheiden sich. Daher wird das Audio neu abgetastet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La frecuencia de origen y el reloj del dispositivo difieren, por lo que el audio se remuestrea."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La fréquence de la source diffère de l’horloge du périphérique : l’audio est donc rééchantillonné."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "La frequenza della sorgente e il clock del dispositivo sono diversi, quindi l’audio viene ricampionato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Частота исходного аудио отличается от тактовой частоты устройства, поэтому звук передискретизируется."
          }
        }
      }
    },
