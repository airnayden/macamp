          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I nomi delle credenziali sono salvati con il server. I valori vanno nel portachiavi."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
