    "profiles.preferences.subtitle": {
      "comment": "One-line subtitle under the Profiles preferences header",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give each listener their own library, playlists, favourites and play history."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Осигурете на всеки слушател собствена библиотека, плейлисти, любими записи и история на слушане."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gib jedem Hörer eine eigene Mediathek, eigene Playlists, Favoriten und einen eigenen Wiedergabeverlauf."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ofrece a cada oyente su propia biblioteca, listas, favoritos e historial de reproducción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Offrez à chaque auditeur sa propre bibliothèque, ses playlists, ses favoris et son historique d’écoute."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Offri a ogni ascoltatore la propria libreria, le proprie playlist, i preferiti e la cronologia di ascolto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "У каждого слушателя будут своя медиатека, плейлисты, избранное и история прослушиваний."
          }
        }
      }
    },
