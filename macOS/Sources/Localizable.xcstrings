    "app.downloads.toast.grantAccess": {
      "comment": "Toast shown when the downloads destination folder cannot be written to, pointing at the macOS privacy setting that grants access",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP не може да пише в папката ви за изтегляния. Дайте достъп в Поверителност и сигурност ▸ Файлове и папки или изберете друга папка в Настройки ▸ Изтегляния."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP kann nicht in deinen Downloadordner schreiben. Erteile Zugriff unter Datenschutz & Sicherheit ▸ Dateien und Ordner oder wähle in Einstellungen ▸ Downloads einen anderen Ordner."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP can’t write to your downloads folder. Grant access in Privacy & Security ▸ Files and Folders, or choose another folder in Settings ▸ Downloads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP no puede escribir en tu carpeta de descargas. Concede acceso en Privacidad y seguridad ▸ Archivos y carpetas, o elige otra carpeta en Ajustes ▸ Descargas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP ne peut pas écrire dans votre dossier de téléchargements. Accordez l’accès dans Confidentialité et sécurité ▸ Fichiers et dossiers, ou choisissez un autre dossier dans Réglages ▸ Téléchargements."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP non può scrivere nella tua cartella dei download. Concedi l’accesso in Privacy e sicurezza ▸ File e cartelle, oppure scegli un’altra cartella in Impostazioni ▸ Download."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "MacAMP can’t write to your downloads folder. Grant access in Privacy & Security ▸ Files and Folders, or choose another folder in Settings ▸ Downloads."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP не может записывать в вашу папку загрузок. Предоставьте доступ в разделе «Конфиденциальность и безопасность» ▸ «Файлы и папки» или выберите другую папку в «Настройки» ▸ «Загрузки»."
          }
        }
      }
    },
