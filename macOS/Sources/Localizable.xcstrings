    "app.preferences.intelligence.control.caption": {
      "comment": "Caption under the assistant playback-control switch, stating the default and what it enables",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Включено по подразбиране. В чата можете да кажете „пусни това“, „пауза“ или „какво звучи?“ и MacAMP го прави веднага."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig aktiv. Im Chat kannst du „spiel das“, „Pause“ oder „was läuft?“ sagen, und MacAMP tut es sofort."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On by default. In chat you can say “play this”, “pause” or “what's playing?” and MacAMP does it straight away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activado por defecto. En el chat puedes decir «reproduce esto», «pausa» o «¿qué suena?» y MacAMP lo hace al instante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activé par défaut. Dans la conversation, dites « joue ça », « pause » ou « qu’est-ce qui passe ? » et MacAMP s’exécute aussitôt."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivo per impostazione predefinita. In chat puoi dire «riproduci questo», «pausa» o «cosa sta suonando?» e MacAMP lo fa subito."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "translated",
            "value": "On by default. In chat you can say “play this”, “pause” or “what's playing?” and MacAMP does it straight away."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Включено по умолчанию. В чате можно сказать «включи это», «пауза» или «что играет?» — и MacAMP сразу выполнит."
          }
        }
      }
    },
    "app.preferences.intelligence.control.off.caption": {
      "comment": "Caption explaining what switching the assistant playback-control off leaves behind",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изключете го за асистент, който може да търси и да предлага плейлисти, но никога не докосва плейъра."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktiviere es für einen Assistenten, der nachschlagen und Playlists vorschlagen, aber den Player nie anfassen darf."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn it off for an assistant that can look things up and suggest playlists, but never touch the player."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactívalo para un asistente que pueda consultar y sugerir listas, pero nunca tocar el reproductor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez-le pour un assistant qui consulte et propose des playlists, mais ne touche jamais au lecteur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivalo per un assistente che consulta e propone playlist, ma non tocca mai il lettore."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn it off for an assistant that can look things up and suggest playlists, but never touch the player."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключите, чтобы ассистент только искал и предлагал плейлисты, но никогда не трогал плеер."
          }
        }
      }
    },
    "app.preferences.intelligence.control.scope.caption": {
      "comment": "Caption bounding what the assistant may control",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "То никога не променя настройките, темите или еквалайзера ви — само какво звучи и какво е на опашката."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ändert nie deine Einstellungen, Themes oder den Equalizer — nur was läuft und was in der Warteschlange steht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It never changes your settings, your themes or your equaliser — only what is playing and what is queued."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca cambia tus ajustes, tus temas ni tu ecualizador: solo lo que suena y lo que está en cola."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il ne modifie jamais vos réglages, vos thèmes ni votre égaliseur — seulement ce qui joue et ce qui est en file."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non modifica mai impostazioni, temi o equalizzatore — solo ciò che suona e ciò che è in coda."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "translated",
            "value": "It never changes your settings, your themes or your equaliser — only what is playing and what is queued."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он никогда не меняет настройки, темы или эквалайзер — только то, что играет и что в очереди."
          }
        }
      }
    },
