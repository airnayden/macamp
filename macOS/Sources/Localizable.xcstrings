    "app.preferences.downloads.engine.checkFailed": {
      "comment": "Status shown when the download-engine update check could not complete",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Каналът с издания на модула е недостъпен. Проверете връзката си и опитайте отново."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Release-Feed der Engine war nicht erreichbar. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't reach the engine's release feed. Check your connection, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido acceder al canal de versiones del motor. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre le flux de versions du moteur. Vérifiez votre connexion, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile raggiungere il feed delle versioni del motore. Controlla la connessione e riprova."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "Couldn't reach the engine's release feed. Check your connection, then try again."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось получить ленту выпусков движка. Проверьте подключение и повторите попытку."
          }
        }
      }
    },
