    "app.assistant.preview.lowConfidence": {
      "comment": "Caption shown when the request could not be parsed and a default mix was produced instead",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Ето отправна точка — MacAMP не разбра напълно заявката, така че опитайте да я преформулирате."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier ist ein Ausgangspunkt – MacAMP war sich nicht sicher, formuliere die Anfrage sonst neu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Here's a starting point — MacAMP wasn't sure what you meant, so try rewording the request if this isn't it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí tienes un punto de partida: MacAMP no lo tuvo claro, prueba a reformular la petición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voici un point de départ — MacAMP n’était pas sûr, reformulez la demande si ce n’est pas ça."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ecco un punto di partenza: MacAMP non era sicuro, prova a riformulare la richiesta."
