    "profiles.archive.sectionFooter": {
      "comment": "Explanatory footer under the profile export/import buttons",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A profile file carries your listening history and replay heatmaps. It never includes your PIN, your library folders, or your profile photo."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Файлът на профила съдържа историята ви на слушане и топлинни карти на повторните слушания. Никога не включва вашия PIN, папките на библиотеката или профилната ви снимка."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Eine Profildatei enthält deinen Hörverlauf und Heatmaps wiederholter Wiedergaben. Sie enthält niemals deine PIN, Mediathekordner oder dein Profilfoto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un archivo de perfil contiene tu historial de escucha y mapas de calor de las repeticiones. Nunca incluye tu PIN, las carpetas de tu biblioteca ni tu foto de perfil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un fichier de profil contient votre historique d’écoute et les cartes de chaleur des réécoutes. Il ne contient jamais votre code PIN, vos dossiers de bibliothèque ni votre photo de profil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un file di profilo contiene la cronologia di ascolto e le mappe di calore dei riascolti. Non include mai il PIN, le cartelle della libreria o la foto del profilo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Файл профиля содержит историю прослушивания и тепловые карты повторных прослушиваний. Он никогда не содержит ваш PIN, папки медиатеки или фото профиля."
          }
        }
      }
    },
