    "profiles.editor.delete.confirmMessage": {
      "comment": "Body of the delete-profile confirmation; argument is the profile name",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%@\" and its playlists, favourites and statistics will be removed. This can't be undone."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„%@“ и неговите плейлисти, любими и статистика ще бъдат премахнати. Това не може да бъде отменено."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„%@“ sowie die zugehörigen Playlists, Favoriten und Statistiken werden entfernt. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se eliminarán «%@» y sus listas de reproducción, favoritos y estadísticas. Esta acción no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "« %@ » ainsi que ses playlists, favoris et statistiques seront supprimés. Cette action est irréversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "“%@” e le relative playlist, i preferiti e le statistiche verranno rimossi. L’operazione non può essere annullata."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«%@», а также его плейлисты, избранное и статистика будут удалены. Это действие нельзя отменить."
          }
        }
      }
    },
