    "app.preferences.intelligence.webSuggestions.consent.cancel.help": {
      "comment": "Tooltip of the button refusing the web-suggestions disclosure",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave web suggestions off. Nothing is saved and nothing is sent."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Оставя предложенията от интернет изключени. Нищо не се запазва и нищо не се изпраща."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lässt Webvorschläge deaktiviert. Nichts wird gespeichert oder gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mantiene desactivadas las sugerencias web. No se guarda ni se envía nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
