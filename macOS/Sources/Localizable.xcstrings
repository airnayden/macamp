    "app.preferences.intelligence.browsing.accept.help": {
      "comment": "Tooltip of the button accepting the library-browsing disclosure",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Съгласявате се този доставчик да прави справки в библиотеката ви, докато отговаря."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erlaube diesem Anbieter, beim Antworten in deiner Mediathek nachzuschlagen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Agree to let this provider look things up in your library while it answers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceptas que este proveedor consulte tu biblioteca mientras responde."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser ce fournisseur à consulter votre bibliothèque pendant qu’il répond."
          }
        },
        "it": {
