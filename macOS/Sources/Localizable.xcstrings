            "value": "Nur Namen, einer pro Zeile — zum Beispiel GITHUB_TOKEN. Die Werte trägst du unten ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Names only, one per line — for example GITHUB_TOKEN. Enter the values below."
          }
        },
        "es": {
