    "app.externalOAuth.claude.stopUsingCLI.help": {
      "comment": "Tooltip explaining that stopping reuse does not sign the Claude command-line tool out",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Спира използването на сесията до следващото стартиране. Инструментът за команден ред Claude остава вписан — данните му за вход никога не се изтриват."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verwendet die Sitzung bis zum nächsten Start nicht mehr. Das Claude-Kommandozeilenwerkzeug bleibt angemeldet – seine Anmeldung wird niemals gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stops using the session until the next launch. The Claude command-line tool stays signed in — its login is never deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deja de usar la sesión hasta el próximo inicio. La herramienta de línea de comandos de Claude sigue conectada; sus datos de acceso nunca se eliminan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cesse d’utiliser la session jusqu’au prochain lancement. L’outil en ligne de commande Claude reste connecté : ses données de connexion ne sont jamais supprimées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Smette di usare la sessione fino al prossimo avvio. Lo strumento a riga di comando Claude rimane connesso: i suoi dati di accesso non vengono mai eliminati."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "Stops using the session until the next launch. The Claude command-line tool stays signed in — its login is never deleted."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Прекращает использование сессии до следующего запуска. Инструмент командной строки Claude остаётся авторизованным — его данные входа никогда не удаляются."
          }
        }
      }
    },
