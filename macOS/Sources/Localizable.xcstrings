      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изберете Apple Intelligence в Настройки ▸ Интелигентност по всяко време, за да остане всичко на този Mac."
          }
        },
        "de": {
          "stringUnit": {
