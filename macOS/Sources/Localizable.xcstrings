            "value": "Ein Programm auf diesem Mac. Es läuft mit deinen Rechten, sobald der Assistent den Server nutzt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A program on this Mac. It runs with your permissions whenever the assistant uses this server."
          }
        },
        "es": {
