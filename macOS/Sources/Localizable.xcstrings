    "app.preferences.downloads.destination.caption": {
      "comment": "Explains that the downloads folder is the listener's own and is not watched by the app",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изтеглянията се запазват тук. Тази папка остава ваша — MacAMP никога не я сканира и не я наблюдава сам."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads werden hier gesichert. Dieser Ordner bleibt deiner — MacAMP durchsucht und überwacht ihn nie von selbst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads are saved here. This folder stays yours — MacAMP never scans or watches it on its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las descargas se guardan aquí. Esta carpeta sigue siendo tuya: MacAMP nunca la analiza ni la vigila por su cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les téléchargements sont enregistrés ici. Ce dossier reste le vôtre : MacAMP ne l’analyse et ne le surveille jamais de lui-même."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I download vengono salvati qui. Questa cartella resta tua: MacAMP non la analizza e non la controlla mai da solo."
          }
        },
        "pseudo": {
