    "app.loudness.caption": {
      "comment": "Explains what the loudness pass does and that it never starts on its own",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measures how loud every track really is, so ReplayGain can even them out. Runs only when you start it, never on import."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Измерва действителната сила на звука на всеки запис, за да може ReplayGain да я изравни. Стартира само по ваше желание, никога при импортиране."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Misst die tatsächliche Lautheit jedes Titels, damit ReplayGain sie angleichen kann. Startet nur auf deinen Wunsch, nie beim Import."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mide el volumen real de cada pista para que ReplayGain pueda igualarlo. Solo se ejecuta cuando lo inicias, nunca al importar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mesure le volume sonore réel de chaque titre pour que ReplayGain puisse l’uniformiser. Ne démarre qu’à votre demande, jamais lors de l’importation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Misura il volume effettivo di ogni brano, così ReplayGain può uniformarlo. Si avvia solo su tua richiesta, mai durante l’importazione."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Измеряет фактическую громкость каждого трека, чтобы ReplayGain мог её выровнять. Запускается только по вашей команде, никогда при импорте."
          }
        }
      }
    },
