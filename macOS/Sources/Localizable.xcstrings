    "profiles.archive.importSucceededWithDrops": {
      "comment": "Toast shown after an import that could not match every track to the local library",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Profile imported — ^[%lld song](inflect: true) isn't in this library, so its play counts were skipped"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Профилът е импортиран — песни, липсващи в тази библиотека: %lld. Броят на възпроизвежданията им е пропуснат."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profil importiert – in dieser Mediathek fehlende Songs: %lld. Ihre Wiedergabezahlen wurden übersprungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Perfil importado: canciones ausentes de esta biblioteca: %lld. Se omitieron sus recuentos de reproducción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profil importé — morceaux absents de cette bibliothèque : %lld. Leurs nombres de lectures ont été ignorés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Profilo importato — brani assenti da questa libreria: %lld. I relativi conteggi di riproduzione sono stati ignorati."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Профиль импортирован — песен, отсутствующих в этой медиатеке: %lld. Их счётчики воспроизведений пропущены."
          }
        }
      }
    },
