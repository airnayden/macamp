    "app.externalOAuth.claude.failure.malformedCode": {
      "comment": "Error shown when the pasted authorization code is not in the expected code#state form",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Това не е целият ред, показан от Claude. Копирайте го изцяло, включително всичко след „#“."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Das ist nicht die vollständige Zeile von Claude. Kopiere alles, einschließlich des gesamten Texts nach „#“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That is not the whole line Claude showed. Copy all of it, including everything after the “#”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esa no es toda la línea que mostró Claude. Cópiala entera, incluido todo lo que va después de «#»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce n’est pas la ligne complète affichée par Claude. Copiez-la entièrement, y compris tout ce qui suit le « # »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questa non è l’intera riga mostrata da Claude. Copiala tutta, compreso ciò che segue “#”."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "That is not the whole line Claude showed. Copy all of it, including everything after the “#”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Это не вся строка, которую показал Claude. Скопируйте её целиком, включая всё после «#»."
          }
        }
      }
    },
    "app.externalOAuth.claude.failure.rejected": {
