          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Until you accept, this provider answers one request at a time and browses nothing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasta que aceptes, este proveedor responde a una solicitud cada vez y no consulta nada."
