    "profiles.preferences.enableFooter": {
      "comment": "Explanatory footer under the Enable Profiles toggle describing Guest behaviour",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When off, the app behaves as a single built-in Guest profile; your profiles and their data are kept."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Когато функцията е изключена, приложението използва само вградения профил „Гост“. Профилите ви и техните данни се запазват."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wenn deaktiviert, verwendet die App nur das integrierte Gastprofil. Deine Profile und ihre Daten bleiben erhalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Si se desactiva, la app usa únicamente el perfil integrado de Invitado. Tus perfiles y sus datos se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lorsque cette option est désactivée, l’app utilise uniquement le profil Invité intégré. Vos profils et leurs données sont conservés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Quando l’opzione è disattivata, l’app usa solo il profilo Ospite integrato. I tuoi profili e i relativi dati vengono conservati."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Когда функция отключена, приложение использует только встроенный профиль «Гость». Ваши профили и их данные сохраняются."
          }
        }
      }
    },
