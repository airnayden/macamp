          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let the assistant use tools published by other programs, beyond your own library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Permite que el asistente use herramientas de otros programas, más allá de tu biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autorisez l’assistant à utiliser des outils d’autres programmes, au-delà de votre bibliothèque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consenti all’assistente di usare strumenti di altri programmi, oltre alla tua libreria."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "Let the assistant use tools published by other programs, beyond your own library."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешите ассистенту использовать инструменты других программ, помимо вашей медиатеки."
          }
        }
      }
    },
