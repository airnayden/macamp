    "app.stats.caption.rawHorizon": {
      "comment": "Explains that some all-time figures only reach back to the month detailed history begins",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Подробностите по песен и час обхващат слушанията от %@; общите данни за изпълнители и жанрове са за целия период."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
