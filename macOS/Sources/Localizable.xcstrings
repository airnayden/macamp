    "app.preferences.intelligence.external.consent.payload.proposals": {
      "comment": "Payload item: an external program may file a proposal but never write to the library",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Може да предложи плейлист, който се появява в MacAMP за преглед. Не може да го запише."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es kann eine Playlist vorschlagen, die in MacAMP zur Prüfung erscheint. Sichern kann es sie nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It can suggest a playlist, which appears in MacAMP for you to review. It cannot save one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puede sugerir una lista, que aparece en MacAMP para que la revises. No puede guardarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il peut proposer une liste de lecture, qui apparaît dans MacAMP pour validation. Il ne peut pas l’enregistrer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Può proporre una playlist, che compare in MacAMP per la tua revisione. Non può salvarla."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "It can suggest a playlist, which appears in MacAMP for you to review. It cannot save one."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Он может предложить плейлист, который появится в MacAMP для проверки. Сохранить его он не может."
          }
        }
      }
    },
    "app.preferences.intelligence.external.consent.payload.size": {
