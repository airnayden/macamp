    "app.preferences.downloads.destination.reset.help": {
      "comment": "Tooltip for the button that restores the default downloads destination",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изтеглянията отново ще се запазват в папката по подразбиране в папката ви Музика."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Downloads wieder im Standardordner in deinem Musikordner sichern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save downloads to the default folder in your Music folder again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volver a guardar las descargas en la carpeta predeterminada dentro de tu carpeta Música."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
