        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta lista cambió después de la vista previa. Genera una nueva sugerencia e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
