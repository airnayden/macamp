    "app.preferences.general.language.relaunch.failed": {
      "comment": "Shown when the relaunch button could not restart the app, so the listener does it",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP не можа да се рестартира сам. Затворете го и го отворете отново, за да смените езика."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP konnte sich nicht selbst neu starten. Beende es und öffne es erneut, um die Sprache zu wechseln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP could not relaunch itself. Quit and open it again to switch language."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP no ha podido reiniciarse solo. Ciérralo y ábrelo de nuevo para cambiar el idioma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP n’a pas pu redémarrer tout seul. Quittez-le et rouvrez-le pour changer de langue."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP non è riuscito a riavviarsi da solo. Chiudilo e riaprilo per cambiare lingua."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "MacAMP could not relaunch itself. Quit and open it again to switch language."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP не смог перезапуститься сам. Завершите его и откройте снова, чтобы сменить язык."
          }
        }
      }
    },
