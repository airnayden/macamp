        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que vous n’acceptez pas, ce fournisseur répond à une demande à la fois et ne parcourt rien."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finché non accetti, questo provider risponde a una richiesta alla volta e non consulta nulla."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "Until you accept, this provider answers one request at a time and browses nothing."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока вы не согласитесь, поставщик отвечает на один запрос за раз и ничего не просматривает."
          }
        }
      }
    },
    "app.preferences.intelligence.browsing.exclusions": {
      "comment": "States what a cloud provider never receives during a conversation",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Никога не се изпращат аудио, имена или местоположения на файлове, обложки и текстове."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es werden nie Audio, Dateinamen oder Speicherorte, Cover oder Songtexte gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No audio, no file names or locations on disk, no artwork and no lyrics are ever sent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nunca se envían audio, nombres o ubicaciones de archivos, ilustraciones ni letras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun contenu audio, nom ou emplacement de fichier, illustration ni parole n’est jamais envoyé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
