    "app.assistant.preview.failureGeneration": {
      "comment": "Shown when a read failed while building a proposal; nothing was written",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP не можа да прочете библиотеката ви, за да състави предложението."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP konnte deine Mediathek nicht lesen, um den Vorschlag zu bauen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP couldn't read your library to build that suggestion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP no ha podido leer tu biblioteca para crear la sugerencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP n’a pas pu lire votre bibliothèque pour construire la suggestion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP non è riuscito a leggere la tua libreria per creare il suggerimento."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "MacAMP couldn't read your library to build that suggestion."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP не смог прочитать медиатеку, чтобы составить предложение."
          }
        }
      }
    },
