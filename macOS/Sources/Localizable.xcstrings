    "app.preferences.output.autoSampleRate": {
      "comment": "Toggle that retunes the output device to the sample rate of the track being started",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Match each track's sample rate"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Съгласуване с честотата на дискретизация на всяка песен"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Abtastrate an jeden Titel anpassen"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adaptar a la frecuencia de muestreo de cada pista"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adapter la fréquence d’échantillonnage à chaque morceau"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Adatta la frequenza di campionamento a ogni brano"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Подстраивать частоту дискретизации под каждый трек"
          }
        }
      }
    },
    "app.preferences.output.autoSampleRate.caption": {
      "comment": "Explains the automatic sample-rate toggle, including that gapless album playback keeps the current rate",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switches the device to a track's own rate when you start that track, avoiding resampling. Gapless album playback keeps the rate already in use, so later tracks in an album are not retuned."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "При пускане на песен превключва устройството към нейната честота, за да избегне повторна дискретизация. Непрекъснатото възпроизвеждане на албум запазва текущата честота, така че следващите песни в албума не я променят."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Stellt das Gerät beim Start eines Titels auf dessen Abtastrate um und vermeidet so Resampling. Bei lückenloser Albumwiedergabe bleibt die aktuelle Rate erhalten; für spätere Titel im Album wird sie nicht neu eingestellt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cambia el dispositivo a la frecuencia propia de la pista al iniciarla, evitando el remuestreo. La reproducción sin pausas de un álbum mantiene la frecuencia en uso, por lo que las pistas posteriores del álbum no la cambian."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Règle l’appareil sur la fréquence du morceau au démarrage, pour éviter le rééchantillonnage. La lecture d’un album sans interruption conserve la fréquence en cours : elle n’est pas réajustée pour les morceaux suivants de l’album."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Imposta il dispositivo sulla frequenza del brano quando lo avvii, evitando il ricampionamento. La riproduzione senza interruzioni di un album mantiene la frequenza in uso, che quindi non cambia per i brani successivi dell’album."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "При запуске трека переключает устройство на его частоту дискретизации, избегая передискретизации. При непрерывном воспроизведении альбома сохраняется текущая частота, поэтому для следующих треков альбома она не меняется."
          }
        }
      }
    },
    "app.preferences.output.autoSampleRate.help": {
      "comment": "Tooltip on the automatic sample-rate toggle",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Retune the output device when a track starts."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Настройва честотата на дискретизация на изходното устройство при започване на запис."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Passt die Abtastrate des Ausgabegeräts beim Start eines Titels an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ajusta la frecuencia de muestreo del dispositivo de salida al iniciar una pista."
          }
        },
        "fr": {
          "stringUnit": {
