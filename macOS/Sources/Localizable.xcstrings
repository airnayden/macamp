    "app.preferences.intelligence.external.caption": {
      "comment": "Caption under the external-access switch",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изключено по подразбиране. Когато е включено, MacAMP отговаря само на ИИ инструменти, работещи на този Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig aus. Wenn aktiviert, beantwortet MacAMP nur Anfragen von KI-Tools auf diesem Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. When on, MacAMP answers questions from AI tools running on this Mac only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado por omisión. Cuando está activo, MacAMP solo responde a herramientas de IA de este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé par défaut. Une fois activé, MacAMP ne répond qu’aux outils d’IA de ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivo per impostazione predefinita. Se attivo, MacAMP risponde solo a strumenti IA su questo Mac."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "Off by default. When on, MacAMP answers questions from AI tools running on this Mac only."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию выключено. Если включено, MacAMP отвечает только ИИ-инструментам на этом Mac."
          }
        }
      }
    },
