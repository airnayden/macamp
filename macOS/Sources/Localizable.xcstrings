    "app.preferences.intelligence.analysis.caption": {
      "comment": "Explains what the audio-analysis pass does and that it never starts on its own",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Измерва темпото, енергичността и яркостта на звука за използване в миксове и правила. Изпълнява се само когато го стартирате."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Misst Tempo, Energie und Klanghelligkeit, damit Mixe und Regeln sie nutzen können. Läuft nur, wenn du die Analyse startest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measures tempo, energy and brightness so mixes and rules can use them. Runs only when you start it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mide el tempo, la energía y el brillo para usarlos en mezclas y reglas. Solo se ejecuta cuando lo inicias."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mesure le tempo, l’énergie et la brillance pour les utiliser dans les mixes et les règles. Ne s’exécute que lorsque vous lancez l’analyse."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Misura tempo, energia e brillantezza per usarli nei mix e nelle regole. Viene eseguita solo quando la avvii."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "Measures tempo, energy and brightness so mixes and rules can use them. Runs only when you start it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Измеряет темп, энергичность и яркость звучания для использования в миксах и правилах. Запускается только по вашей команде."
          }
        }
      }
    },
