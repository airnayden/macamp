    "app.preferences.karaoke.prune.caption": {
      "comment": "Explains the karaoke cache-size-limit toggle",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Автоматично премахва инструменталните версии, които не са използвани най-отдавна, за да спази ограничението за размер."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Entfernt automatisch die am längsten nicht verwendeten Instrumentalversionen, um die Größenbegrenzung einzuhalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically remove the least-recently-used instrumentals to stay under the size limit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elimina automáticamente las versiones instrumentales que llevan más tiempo sin usarse para no superar el límite de tamaño."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Supprime automatiquement les versions instrumentales inutilisées depuis le plus longtemps pour respecter la limite de taille."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rimuove automaticamente le versioni strumentali non utilizzate da più tempo per rispettare il limite di dimensione."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "Automatically remove the least-recently-used instrumentals to stay under the size limit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Автоматически удаляет инструментальные версии, которые дольше всего не использовались, чтобы не превышать ограничение размера."
          }
        }
      }
    },
