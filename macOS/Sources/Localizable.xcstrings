    "app.preferences.intelligence.browsing.cancel.help": {
      "comment": "Tooltip of the button declining the library-browsing disclosure",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Разговорите остават изключени за този доставчик. Единичните заявки продължават да работят."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Unterhaltungen für diesen Anbieter ausgeschaltet lassen. Einzelanfragen funktionieren weiterhin."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep conversations off for this provider. Single requests still work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantener las conversaciones desactivadas para este proveedor. Las solicitudes únicas siguen funcionando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
