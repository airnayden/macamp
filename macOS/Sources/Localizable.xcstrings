    "app.preferences.intelligence.external.control.toggle": {
      "comment": "The switch allowing a connected external program to control playback",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволяване и да пускат и спират музиката ви"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie dürfen deine Musik auch abspielen und pausieren"
