    "app.preferences.intelligence.external.port.caption": {
      "comment": "Caption under the port field",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Натиснете Return, за да приложите. Ако портът е зает, MacAMP го казва, вместо да смени порта."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Anwenden die Eingabetaste drücken. Ist der Port belegt, sagt MacAMP das, statt auszuweichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Press Return to apply. If the port is taken, MacAMP says so rather than moving."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa Retorno para aplicar. Si el puerto está ocupado, MacAMP lo indica en vez de cambiarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez sur Retour pour appliquer. Si le port est occupé, MacAMP le signale au lieu d’en changer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi Invio per applicare. Se la porta è occupata, MacAMP lo segnala invece di cambiarla."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
