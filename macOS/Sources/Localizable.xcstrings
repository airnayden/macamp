    "settings.playback.karaoke.caption": {
      "comment": "Explains the karaoke-mode toggle",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Премахва вокалите от песните. Инструменталите се подготвят във фонов режим и се кешират на диска."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Entferne Gesang aus deinen Titeln. Instrumentals werden im Hintergrund vorbereitet und auf dem Datenträger gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove vocals from your tracks. Instrumentals are prepared in the background and cached on disk."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Elimina las voces de tus canciones. Los instrumentales se preparan en segundo plano y se guardan en la caché del disco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Supprimez les voix de vos titres. Les instrumentaux sont préparés en arrière-plan et mis en cache sur le disque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Rimuovi la voce dai brani. Le basi vengono preparate in background e salvate nella cache su disco."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "Remove vocals from your tracks. Instrumentals are prepared in the background and cached on disk."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Удаляйте вокал из композиций. Инструменталы готовятся в фоновом режиме и сохраняются в кэше на диске."
          }
        }
      }
    },
