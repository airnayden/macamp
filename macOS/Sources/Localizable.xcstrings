          }
        }
      }
    },
    "app.preferences.intelligence.external.consent.reversible": {
      "comment": "States how to stop allowing external access",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изключете това по всяко време в Настройки ▸ Интелигентност, за да затворите връзката."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deaktiviere dies jederzeit unter Einstellungen ▸ Intelligence, um die Verbindung zu schließen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn this off in Preferences ▸ Intelligence at any time to close the connection."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactívalo cuando quieras en Ajustes ▸ Inteligencia para cerrar la conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez-le à tout moment dans Réglages ▸ Intelligence pour fermer la connexion."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivalo quando vuoi in Impostazioni ▸ Intelligence per chiudere la connessione."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "Turn this off in Preferences ▸ Intelligence at any time to close the connection."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключите это в любой момент в Настройках ▸ Интеллект, чтобы закрыть соединение."
          }
        }
      }
    },
    "app.preferences.intelligence.external.consent.title": {
      "comment": "Title of the sheet shown before external access may be switched on",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Да разреша ли на други програми на този Mac да четат библиотеката ви?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anderen Programmen auf diesem Mac erlauben, deine Mediathek zu lesen?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Let other programs on this Mac read your library?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Permitir que otros programas de este Mac consulten tu biblioteca?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Autoriser d’autres programmes de ce Mac à lire votre bibliothèque ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Consentire ad altri programmi su questo Mac di leggere la tua libreria?"
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "Let other programs on this Mac read your library?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить другим программам на этом Mac читать вашу медиатеку?"
          }
        }
      }
    },
    "app.preferences.intelligence.external.control.caption": {
      "comment": "Caption under the external playback-control switch, stating the default and what it allows",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Изключено по подразбиране. Свързан инструмент може да пуска, спира и прескача музиката ви и да променя какво следва."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Standardmäßig aus. Ein verbundenes Werkzeug könnte deine Musik starten, pausieren, überspringen und ändern, was als Nächstes läuft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. A connected tool could start, pause and skip your music, and change what plays next."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactivado por defecto. Una herramienta conectada podría iniciar, pausar y saltar tu música, y cambiar lo que suena a continuación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivé par défaut. Un outil connecté pourrait lancer, mettre en pause et passer votre musique, et changer la suite."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivo per impostazione predefinita. Uno strumento connesso potrebbe avviare, mettere in pausa e saltare la tua musica, e cambiare cosa suona dopo."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "translated",
            "value": "Off by default. A connected tool could start, pause and skip your music, and change what plays next."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "По умолчанию выключено. Подключённый инструмент сможет запускать, ставить на паузу и пропускать музыку, а также менять, что играет дальше."
          }
        }
      }
    },
    "app.preferences.intelligence.external.control.needsAccess": {
      "comment": "Caption explaining that the external playback-control switch depends on external access being on",
      "extractionState": "manual",
      "localizations": {
