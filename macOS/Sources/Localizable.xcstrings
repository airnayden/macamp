        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ассистент не смог ответить. Повторите попытку или переформулируйте вопрос."
          }
        }
      }
    },
    "app.assistant.chat.failure.consent": {
      "comment": "Message shown when a conversation turn was refused for want of the library-browsing agreement",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този доставчик се нуждае от вашето разрешение да преглежда библиотеката ви, преди да води разговор."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Anbieter braucht deine Erlaubnis, deine Mediathek zu durchsuchen, bevor er ein Gespräch führen kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This provider needs your permission to browse your library before it can hold a conversation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este proveedor necesita tu permiso para consultar tu biblioteca antes de mantener una conversación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce fournisseur a besoin de votre autorisation pour parcourir votre bibliothèque avant de converser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo provider ha bisogno del tuo permesso per consultare la libreria prima di conversare."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "This provider needs your permission to browse your library before it can hold a conversation."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этому поставщику нужно ваше разрешение на просмотр медиатеки, прежде чем вести разговор."
