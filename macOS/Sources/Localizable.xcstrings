    "app.preferences.intelligence.mcp.edit.save.help": {
      "comment": "Tooltip of the button committing the MCP server sheet",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Запазете този сървър. Остава изключен, докато не го включите."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen Server sichern. Er bleibt aus, bis du ihn einschaltest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save this server. It stays off until you switch it on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda este servidor. Permanece desactivado hasta que lo actives."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez ce serveur. Il reste désactivé jusqu’à ce que vous l’activiez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva questo server. Resta disattivato finché non lo attivi."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "Save this server. It stays off until you switch it on."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранить этот сервер. Он останется выключенным, пока вы его не включите."
          }
        }
      }
    },
    "app.preferences.intelligence.mcp.edit.subtitle": {
      "comment": "Subtitle of the MCP server sheet, stating where names and values are each stored",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Имената на идентификационните данни се пазят със сървъра. Стойностите отиват в Keychain."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Namen der Zugangsdaten werden beim Server gesichert. Ihre Werte kommen in den Schlüsselbund."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Credential names are saved with the server. Their values go to your Keychain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nombres de las credenciales se guardan con el servidor. Sus valores van a tu Llavero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
