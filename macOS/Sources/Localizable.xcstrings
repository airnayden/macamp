    "app.lyrics.browser.emptyMessage": {
      "comment": "Empty-state message on the Lyrics browser explaining how lyrics get cached",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
