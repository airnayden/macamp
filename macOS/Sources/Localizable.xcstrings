    "app.externalOAuth.claude.caption": {
      "comment": "Explains what signing in with a Claude subscription does and where the session is stored",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Използвайте своя план Claude Pro или Max вместо API ключ. Сесията се съхранява в Keychain; паролата ви никога не се вижда или запазва."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verwende deinen Claude Pro- oder Max-Tarif anstelle eines API-Schlüssels. Die Sitzung wird in deinem Schlüsselbund gespeichert; dein Passwort wird niemals eingesehen oder gespeichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use your Claude Pro or Max plan instead of an API key. The session is stored in your Keychain; your password is never seen or saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usa tu plan Claude Pro o Max en lugar de una clave de API. La sesión se guarda en tu llavero; tu contraseña nunca se ve ni se guarda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Utilisez votre abonnement Claude Pro ou Max au lieu d’une clé API. La session est conservée dans votre trousseau ; votre mot de passe n’est jamais consulté ni enregistré."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Usa il tuo piano Claude Pro o Max al posto di una chiave API. La sessione è conservata nel portachiavi; la password non viene mai vista o salvata."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "Use your Claude Pro or Max plan instead of an API key. The session is stored in your Keychain; your password is never seen or saved."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Используйте план Claude Pro или Max вместо API-ключа. Сессия хранится в связке ключей; ваш пароль никогда не просматривается и не сохраняется."
          }
        }
      }
    },
    "app.externalOAuth.claude.cli.caption": {
      "comment": "Caption shown when the app is reusing a session belonging to the Claude command-line tool",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Тази сесия идва от инструмента за команден ред Claude, в който вече сте влезли на този Mac. Тук нищо не е съхранено и изходът по-долу никога не изтрива данните за вход на този инструмент."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese Sitzung stammt vom Claude-Kommandozeilenwerkzeug, das auf diesem Mac bereits angemeldet ist. Hier wurde nichts gespeichert, und die Abmeldung unten löscht niemals die Anmeldung dieses Werkzeugs."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This session comes from the Claude command-line tool already signed in on this Mac. Nothing was stored here, and signing out below never deletes that tool’s login."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta sesión procede de la herramienta de línea de comandos de Claude, que ya tiene una sesión iniciada en este Mac. Aquí no se guardó nada y cerrar sesión abajo nunca elimina el acceso de esa herramienta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette session provient de l’outil en ligne de commande Claude, déjà connecté sur ce Mac. Rien n’a été enregistré ici et se déconnecter ci-dessous ne supprime jamais la connexion de cet outil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questa sessione proviene dallo strumento a riga di comando Claude, già connesso su questo Mac. Qui non è stato salvato nulla e disconnettersi qui sotto non elimina mai l’accesso di tale strumento."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "This session comes from the Claude command-line tool already signed in on this Mac. Nothing was stored here, and signing out below never deletes that tool’s login."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Эта сессия получена из инструмента командной строки Claude, в котором уже выполнен вход на этом Mac. Здесь ничего не сохранялось, и выход ниже никогда не удаляет данные входа этого инструмента."
          }
        }
      }
    },
    "app.externalOAuth.claude.code.instructions": {
      "comment": "Instructions telling the user to copy the code Claude displays on its callback page and paste it back",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Одобрете достъпа в браузъра. След това Claude показва един ред текст — копирайте целия ред и го поставете по-долу."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Erlaube den Zugriff im Browser. Claude zeigt dann eine einzelne Textzeile – kopiere sie vollständig und füge sie unten ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Approve access in your browser. Claude then shows a single line of text — copy all of it and paste it below."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autoriza el acceso en el navegador. Claude mostrará una sola línea de texto; cópiala entera y pégala abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autorisez l’accès dans votre navigateur. Claude affiche ensuite une seule ligne de texte : copiez-la entièrement et collez-la ci-dessous."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Autorizza l’accesso nel browser. Claude mostrerà una sola riga di testo: copiala per intero e incollala qui sotto."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "Approve access in your browser. Claude then shows a single line of text — copy all of it and paste it below."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Разрешите доступ в браузере. Затем Claude покажет одну строку текста — скопируйте её целиком и вставьте ниже."
          }
        }
      }
    },
