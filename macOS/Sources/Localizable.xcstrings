    "app.eq.parametric.preamp.caption": {
      "comment": "Explains what the parametric pre-amp trim is for",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A negative trim makes headroom so the boosted filters do not clip. An imported profile brings its own."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Отрицателната стойност осигурява запас, за да не се получи клипинг при усилване от филтрите. Импортираният профил съдържа собствена стойност."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein negativer Wert schafft Aussteuerungsreserve, damit angehobene Filter nicht übersteuern. Ein importiertes Profil bringt seinen eigenen Wert mit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un valor negativo deja margen para que los filtros que amplifican no provoquen recorte. Los perfiles importados incluyen su propio valor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Une valeur négative laisse une marge pour éviter l’écrêtage lorsque les filtres amplifient le signal. Un profil importé fournit sa propre valeur."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Un valore negativo lascia margine per evitare il clipping causato dai filtri che amplificano il segnale. Un profilo importato include il proprio valore."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Отрицательное значение создаёт запас, чтобы усиление фильтрами не вызывало клиппинг. Импортированный профиль содержит собственное значение."
          }
        }
      }
    },
