    "app.preferences.intelligence.external.consent.payload.stats": {
      "comment": "Payload item: the listening aggregates an external lookup can return",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Вашата статистика на слушане — какво сте пускали, колко често и кога."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Hörstatistik — was du gespielt hast, wie oft und wann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your listening statistics — what you played, how often, and when."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
