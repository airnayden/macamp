        }
      }
    },
    "app.eq.parametric.error.engineRefused": {
      "comment": "Error shown when the playback engine refused a parametric configuration for an unnamed reason",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
