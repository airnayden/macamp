    "app.preferences.output.device.caption": {
      "comment": "Explains the output device picker's System Default option",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "System Default follows whatever device macOS is using. Pick a device to keep MacAMP on it."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„Системно по подразбиране“ следва устройството, което macOS използва. Изберете конкретно устройство, за да остане MacAMP на него."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "„Systemstandard“ folgt dem von macOS verwendeten Gerät. Wähle ein bestimmtes Gerät, damit MacAMP es beibehält."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Predeterminado del sistema» sigue el dispositivo que utiliza macOS. Elige un dispositivo para que MacAMP siga usándolo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "« Par défaut du système » suit le périphérique utilisé par macOS. Choisissez un périphérique précis pour que MacAMP continue à l’utiliser."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Predefinito di sistema» segue il dispositivo usato da macOS. Scegli un dispositivo specifico per mantenerlo come uscita di MacAMP."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "«Системное по умолчанию» использует устройство, выбранное в macOS. Выберите конкретное устройство, чтобы MacAMP продолжал использовать его."
          }
        }
      }
    },
    "app.preferences.output.device.help": {
