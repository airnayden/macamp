            "value": "Quando questa opzione è attiva:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Когда эта функция включена:"
          }
        }
      }
    },
    "app.preferences.intelligence.webSuggestions.consent.lead": {
      "comment": "Lead paragraph of the web-suggestions disclosure",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning this on lets the assistant recommend songs you do not own, and check that each link it offers really plays."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Включването позволява на асистента да препоръчва песни, които не притежавате, и да проверява дали всяка предложена връзка наистина възпроизвежда музика."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Wenn du dies aktivierst, kann der Assistent Songs empfehlen, die du nicht besitzt, und prüfen, ob sich jeder angebotene Link tatsächlich abspielen lässt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Al activarlo, el asistente puede recomendar canciones que no tienes y comprobar que cada enlace que ofrece se reproduce de verdad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "En activant cette option, l’assistant peut recommander des morceaux que vous ne possédez pas et vérifier que chaque lien proposé permet bien de les écouter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Attivando questa opzione, l’assistente può consigliare brani che non possiedi e verificare che ogni link proposto consenta davvero la riproduzione."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "После включения ассистент сможет рекомендовать песни, которых у вас нет, и проверять, что каждая предложенная ссылка действительно позволяет их воспроизвести."
          }
        }
      }
    },
    "app.preferences.intelligence.webSuggestions.consent.rateLimitItem": {
      "comment": "Disclosure row explaining keyless rate limits and what an optional key changes",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without a key, both services run in a rate-limited free mode. Adding your own key raises those limits and changes nothing about what is sent."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Без ключ и двете услуги работят в безплатен режим с ограничена честота на заявките. Добавянето на собствен ключ увеличава тези лимити и не променя изпращаните данни."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ohne Schlüssel laufen beide Dienste kostenlos mit begrenzter Anfragerate. Ein eigener Schlüssel erhöht diese Limits, ändert aber nichts an den gesendeten Daten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sin clave, ambos servicios funcionan en modo gratuito con un límite de solicitudes. Añadir tu propia clave aumenta esos límites sin cambiar los datos que se envían."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Sans clé, les deux services fonctionnent gratuitement avec une fréquence de requêtes limitée. Ajouter votre propre clé augmente ces limites sans modifier les données envoyées."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Senza chiave, entrambi i servizi funzionano gratuitamente con un limite di richieste. Aggiungere una chiave personale aumenta questi limiti senza cambiare i dati inviati."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Без ключа оба сервиса работают бесплатно с ограниченной частотой запросов. Собственный ключ повышает эти лимиты, не меняя состав отправляемых данных."
          }
        }
      }
    },
    "app.preferences.intelligence.webSuggestions.consent.reversible": {
      "comment": "Note stating the web-suggestions grant is reversible",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can switch this off again at any time, and remove a saved key with it."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Можете да изключите тази функция по всяко време и да премахнете запазен ключ."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Du kannst diese Funktion jederzeit wieder deaktivieren und dabei einen gespeicherten Schlüssel entfernen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Puedes desactivarlo de nuevo cuando quieras y eliminar también una clave guardada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vous pouvez désactiver cette option à tout moment et supprimer une clé enregistrée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Puoi disattivare questa opzione in qualsiasi momento e rimuovere anche una chiave salvata."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вы можете в любой момент выключить эту функцию и удалить сохранённый ключ."
          }
        }
      }
    },
    "app.preferences.intelligence.webSuggestions.consent.searchItem": {
      "comment": "Disclosure row naming the search provider that receives song titles and artists",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The titles and artists of songs that are not in your library are sent to the search provider, %@, to find them."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Заглавията и изпълнителите на песни, които не са в библиотеката ви, се изпращат до доставчика на търсене %@, за да бъдат намерени."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Titel und Interpreten von Songs, die nicht in deiner Mediathek sind, werden an den Suchanbieter %@ gesendet, um sie zu finden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los títulos y artistas de canciones que no están en tu biblioteca se envían al proveedor de búsqueda, %@, para encontrarlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les titres et artistes des morceaux absents de votre bibliothèque sont envoyés au fournisseur de recherche, %@, pour les trouver."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I titoli e gli artisti dei brani che non sono nella tua libreria vengono inviati al fornitore di ricerca, %@, per trovarli."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Названия и исполнители песен, которых нет в вашей медиатеке, отправляются поисковому провайдеру %@, чтобы найти эти песни."
          }
