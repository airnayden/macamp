          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Lascia disattivati i suggerimenti dal web. Nulla viene salvato o inviato."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Оставить рекомендации из интернета выключенными. Ничего не сохраняется и не отправляется."
          }
        }
      }
    },
    "app.preferences.intelligence.webSuggestions.consent.cloudOnlyItem": {
      "comment": "Disclosure row stating the feature is active only on the cloud tier, never on-device",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This happens only while a cloud AI provider is selected. The on-device assistant is never given these lookups, so nothing leaves this Mac on that setting."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Това се случва само когато е избран облачен AI доставчик. Асистентът на устройството никога не извършва тези търсения, така че при тази настройка нищо не напуска този Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dies geschieht nur, wenn ein Cloud-KI-Anbieter ausgewählt ist. Der Assistent auf dem Gerät erhält diese Suchfunktionen nie, sodass bei dieser Einstellung nichts diesen Mac verlässt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esto solo ocurre cuando se selecciona un proveedor de IA en la nube. El asistente del dispositivo nunca recibe estas funciones de búsqueda, por lo que con esa opción no sale nada de este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cela se produit uniquement lorsqu’un fournisseur d’IA cloud est sélectionné. L’assistant sur l’appareil n’a jamais accès à ces recherches : avec ce réglage, rien ne quitte ce Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questo avviene solo quando è selezionato un fornitore di IA cloud. L’assistente sul dispositivo non dispone mai di queste ricerche, quindi con tale impostazione nulla lascia questo Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Это происходит только при выборе облачного ИИ-провайдера. Ассистенту на устройстве эти поисковые функции недоступны, поэтому при такой настройке ничего не покидает этот Mac."
          }
        }
      }
    },
    "app.preferences.intelligence.webSuggestions.consent.exclusions": {
      "comment": "Note listing what the web-suggestions feature never sends",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your files, file paths, playlists and listening history are never sent — only the song text needed to search for a track."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Вашите файлове, пътища до файлове, плейлисти и история на слушане никога не се изпращат — само текстът, необходим за търсене на песен."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Deine Dateien, Dateipfade, Playlists und dein Hörverlauf werden niemals gesendet – nur der Text, der zum Suchen eines Songs nötig ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Nunca se envían tus archivos, rutas de archivos, listas de reproducción ni historial de escucha; solo el texto necesario para buscar una pista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Vos fichiers, chemins de fichiers, playlists et historique d’écoute ne sont jamais envoyés — uniquement le texte nécessaire pour rechercher un morceau."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Non vengono mai inviati file, percorsi dei file, playlist o cronologia di ascolto, ma solo il testo necessario per cercare un brano."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ваши файлы, пути к файлам, плейлисты и история прослушивания никогда не отправляются — только текст, необходимый для поиска трека."
          }
        }
      }
    },
    "app.preferences.intelligence.webSuggestions.consent.heading": {
      "comment": "Heading above the list of things the web-suggestions feature does",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While this is on:"
          }
        },
        "bg": {
