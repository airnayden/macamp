        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ein anderer Vorschlag wird noch vorbereitet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Another suggestion is still being prepared"
