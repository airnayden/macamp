    "app.preferences.intelligence.mcp.field.secrets.caption": {
      "comment": "Caption stating where MCP credential values are stored and what a blank field means",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Пазят се в Keychain, никога в настройките. Оставете празно, за да запазите вече записаното."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Im Schlüsselbund gesichert, nie in den Einstellungen. Leer lassen behält das Gesicherte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored in your Keychain, never in preferences. Leave one blank to keep what is already saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guardan en tu Llavero, nunca en las preferencias. Déjalo vacío para conservar lo guardado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservées dans votre trousseau, jamais dans les réglages. Laissez vide pour garder l’existant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvati nel portachiavi, mai nelle preferenze. Lascia vuoto per mantenere quanto già salvato."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "Stored in your Keychain, never in preferences. Leave one blank to keep what is already saved."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Хранятся в связке ключей, а не в настройках. Оставьте пустым, чтобы сохранить прежнее."
          }
        }
      }
