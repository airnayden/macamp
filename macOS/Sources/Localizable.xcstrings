          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Per-track and time-of-day detail covers plays since %@; artist and genre totals are all-time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Los detalles por canción y hora abarcan las reproducciones desde %@; los totales por artista y género son históricos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Le détail par titre et par heure couvre les écoutes depuis %@ ; les totaux par artiste et genre portent sur toute la période."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I dettagli per brano e ora coprono le riproduzioni dal %@; i totali per artista e genere sono complessivi."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
