    "app.signalPath.badge.directPath.subtitle": {
      "comment": "Explanation shown beneath the Direct path badge, stating what remains outside the app's control",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP is changing nothing: no gain, equalization, crossfeed, balance or resampling. The system mixer and the output volume are still outside this app’s control."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MacAMP не променя нищо: няма усилване, еквализация, кръстосано смесване, промяна на баланса или преизчисляване на честотата на дискретизация. Системният миксер и изходната сила на звука остават извън контрола на приложението."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MacAMP verändert nichts: keine Verstärkung, Entzerrung, Kanalüberblendung, Balanceänderung oder Abtastratenwandlung. Der Systemmixer und die Ausgabelautstärke liegen weiterhin außerhalb der Kontrolle dieser App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MacAMP no modifica nada: ni ganancia, ni ecualización, ni mezcla cruzada, ni balance, ni frecuencia de muestreo. El mezclador del sistema y el volumen de salida siguen fuera del control de esta app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MacAMP ne modifie rien : ni gain, ni égalisation, ni mélange croisé, ni balance, ni fréquence d’échantillonnage. Le mixeur du système et le volume de sortie restent hors du contrôle de cette app."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MacAMP non modifica nulla: nessun guadagno, equalizzazione, miscelazione incrociata, bilanciamento o ricampionamento. Il mixer di sistema e il volume di uscita restano al di fuori del controllo dell’app."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MacAMP ничего не меняет: без усиления, эквализации, перекрёстного смешивания, изменения баланса или частоты дискретизации. Системный микшер и выходная громкость по-прежнему находятся вне контроля приложения."
          }
        }
      }
    },
