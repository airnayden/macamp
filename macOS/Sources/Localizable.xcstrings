    "app.preferences.intelligence.mcp.edit.help": {
      "comment": "Tooltip of the button that edits one MCP server",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Променете името на сървъра, как MacAMP го достига и какви идентификационни данни му трябват."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ändere Name, Erreichbarkeit und benötigte Zugangsdaten dieses Servers."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Change this server's name, how MacAMP reaches it, and which credentials it needs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia el nombre del servidor, cómo lo alcanza MacAMP y qué credenciales necesita."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifiez le nom du serveur, la façon dont MacAMP l’atteint et ses identifiants."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambia nome del server, come MacAMP lo raggiunge e quali credenziali richiede."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "Change this server's name, how MacAMP reaches it, and which credentials it needs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Измените имя сервера, способ подключения и необходимые учётные данные."
          }
        }
      }
    },
