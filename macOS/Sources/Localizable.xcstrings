    "app.preferences.intelligence.mcp.field.command.caption": {
      "comment": "Caption stating that a command-backed MCP server runs a local program",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Програма на този Mac. Изпълнява се с вашите права, когато асистентът ползва този сървър."
          }
        },
        "de": {
