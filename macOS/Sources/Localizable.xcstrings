        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MacAMP recherche encore des paroles intégrées et des fichiers .lrc dans votre bibliothèque. Lancez l’enrichissement pour rechercher des paroles en ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
