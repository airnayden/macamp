    "app.preferences.downloads.engine.stale": {
      "comment": "Warning shown when the installed download engine's own release date is over 90 days ago",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Този модул е на повече от 90 дни. YouTube се променя често, затова стар модул може да започне да се проваля — проверете за актуализация."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Engine ist über 90 Tage alt. YouTube ändert sich oft, daher kann eine alte Engine anfangen zu versagen – suche nach einem Update."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This engine is more than 90 days old. YouTube changes often, so an old engine may start failing — check for an update."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este motor tiene más de 90 días. YouTube cambia a menudo, así que un motor antiguo puede empezar a fallar; busca una actualización."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce moteur a plus de 90 jours. YouTube change souvent : un moteur ancien peut commencer à échouer — recherchez une mise à jour."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo motore ha più di 90 giorni. YouTube cambia spesso, quindi un motore vecchio può iniziare a non funzionare: cerca un aggiornamento."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "This engine is more than 90 days old. YouTube changes often, so an old engine may start failing — check for an update."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Этому движку больше 90 дней. YouTube часто меняется, поэтому старый движок может начать давать сбои — проверьте наличие обновления."
          }
        }
      }
    },
