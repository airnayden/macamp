    "app.fileAccess.description": {
      "comment": "Explains that chosen folders are monitored and auto-imported",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Тези папки се следят за промени и се синхронизират с вашата библиотека."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Ordner werden auf Änderungen überwacht und mit deiner Mediathek synchronisiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These folders are watched for changes and kept in sync with your library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas carpetas se supervisan en busca de cambios y se mantienen sincronizadas con tu biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces dossiers sont surveillés et maintenus synchronisés avec votre bibliothèque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste cartelle vengono monitorate per rilevare modifiche e mantenute sincronizzate con la tua libreria."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эти папки отслеживаются на изменения и синхронизируются с вашей медиатекой."
          }
        }
      }
    },
    "app.fileAccess.empty.message": {
      "comment": "Body shown when no library folders have been added",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавете папка, за да започнете да изграждате библиотеката си. Новите и променените файлове се импортират автоматично."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge einen Ordner hinzu, um deine Mediathek aufzubauen. Neue und geänderte Dateien werden automatisch importiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a folder to start building your library. New and changed files are imported automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una carpeta para empezar a crear tu biblioteca. Los archivos nuevos y modificados se importan automáticamente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un dossier pour commencer à constituer votre bibliothèque. Les fichiers nouveaux et modifiés sont importés automatiquement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una cartella per iniziare a creare la tua libreria. I file nuovi e modificati vengono importati automaticamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте папку, чтобы начать формировать медиатеку. Новые и изменённые файлы импортируются автоматически."
          }
        }
      }
    },
