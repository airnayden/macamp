          }
        }
      }
    },
    "app.preferences.intelligence.browsing.default": {
      "comment": "States that the one-shot request path is unaffected while the disclosure is unaccepted",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Докато не приемете, този доставчик отговаря на по една заявка и не преглежда нищо."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
