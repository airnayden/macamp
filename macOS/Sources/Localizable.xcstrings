        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette playlist n’a pas encore été suffisamment analysée — lancez Analyser dans Réglages ▸ Intelligence"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questa playlist non è ancora stata analizzata a sufficienza: avvia Analizza in Impostazioni ▸ Intelligence"
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "Not enough of this playlist has been analyzed yet — run Analyze in Settings ▸ Intelligence"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "В этом плейлисте ещё недостаточно проанализированных треков — запустите «Анализировать» в Настройки ▸ Intelligence"
          }
        }
      }
    },
