    "app.ai.action.alreadyInOrder": {
      "comment": "Toast shown when an energy reorder would move nothing",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Този плейлист вече е подреден по енергичност"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Diese Playlist ist bereits nach Energie geordnet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This playlist is already in energy order"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Esta lista ya está ordenada por energía"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette playlist est déjà classée par énergie"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questa playlist è già ordinata per energia"
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "This playlist is already in energy order"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Этот плейлист уже упорядочен по энергичности"
          }
        }
      }
    },
    "app.ai.action.busy": {
      "comment": "Toast shown when an AI action is requested while one is already running",
      "extractionState": "manual",
      "localizations": {
