    "app.replayGainTags.unmeasuredNote": {
      "comment": "Explains that unmeasured files are left alone and how to measure them",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tracks MacAMP has not measured yet are left untouched. Scan your library first in Settings ▸ Playback ▸ Loudness."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Записите, чиято сила на звука MacAMP все още не е измерил, остават непроменени. Първо сканирайте библиотеката си в Настройки ▸ Възпроизвеждане ▸ Сила на звука."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Titel, die MacAMP noch nicht gemessen hat, bleiben unverändert. Analysiere zuerst deine Mediathek unter Einstellungen ▸ Wiedergabe ▸ Lautheit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Las pistas cuyo volumen MacAMP aún no ha medido no se modificarán. Primero analiza la biblioteca en Ajustes ▸ Reproducción ▸ Volumen sonoro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Les titres dont MacAMP n’a pas encore mesuré le volume sonore restent inchangés. Analysez d’abord votre bibliothèque dans Réglages ▸ Lecture ▸ Volume sonore."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "I brani di cui MacAMP non ha ancora misurato il volume restano invariati. Analizza prima la libreria in Impostazioni ▸ Riproduzione ▸ Volume sonoro."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Треки, громкость которых MacAMP ещё не измерил, остаются без изменений. Сначала просканируйте медиатеку в разделе Настройки ▸ Воспроизведение ▸ Громкость."
          }
        }
      }
    },
