    "app.assistant.chat.failure.authExpired": {
      "comment": "Message shown when a conversation turn failed because the provider's credential was rejected",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This provider rejected its saved sign-in. Sign in to it again in Preferences ▸ Intelligence, then ask again."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Този доставчик отхвърли запазените данни за вход. Влезте отново в Настройки ▸ Интелигентни функции, след което повторете заявката."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dieser Anbieter hat die gespeicherte Anmeldung abgelehnt. Melde dich in Einstellungen ▸ Intelligenz erneut an und stelle deine Anfrage noch einmal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Este proveedor rechazó la sesión guardada. Vuelve a iniciar sesión en Ajustes ▸ Inteligencia y repite la solicitud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Ce fournisseur a refusé les identifiants enregistrés. Reconnectez-vous dans Réglages ▸ Intelligence, puis renouvelez votre demande."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Questo fornitore ha rifiutato le credenziali salvate. Accedi di nuovo in Impostazioni ▸ Intelligenza, poi ripeti la richiesta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Этот провайдер отклонил сохранённые данные входа. Войдите снова в Настройки ▸ Интеллект, затем повторите запрос."
          }
        }
      }
    },
