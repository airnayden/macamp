            "state": "translated",
            "value": "Oubliez ce serveur, supprimez ses identifiants enregistrés et retirez votre autorisation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dimentica questo server, elimina le credenziali salvate e revoca il permesso."
          }
        },
