    "app.preferences.intelligence.mcp.persistFailed": {
      "comment": "Caption shown when saving or removing an MCP server could not settle both stores",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Промяната не можа да се запази. Проверете дали Keychain е отключен и опитайте пак."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Änderung konnte nicht gesichert werden. Prüfe, ob dein Schlüsselbund entsperrt ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That change could not be saved. Check that your Keychain is unlocked, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el cambio. Comprueba que tu Llavero esté desbloqueado e inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Modification non enregistrée. Vérifiez que votre trousseau est déverrouillé, puis réessayez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Modifica non salvata. Verifica che il portachiavi sia sbloccato e riprova."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
