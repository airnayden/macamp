        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni le conversazioni disattivate per questo provider. Le richieste singole continuano a funzionare."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
