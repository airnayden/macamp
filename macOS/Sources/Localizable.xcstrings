    "app.assistant.chat.failure.answer": {
      "comment": "Message shown on a conversation turn that produced no answer",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Асистентът не можа да отговори. Опитайте отново или попитайте по друг начин."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
