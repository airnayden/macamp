          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MacAMP все още търси в библиотеката ви вградени текстове и текстове във файлове .lrc. Стартирайте обогатяването, за да ги потърсите онлайн."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "MacAMP durchsucht deine Mediathek noch nach eingebetteten Liedtexten und .lrc-Dateien. Starte die Anreicherung, um online nach Liedtexten zu suchen."
          }
        },
        "es": {
          "stringUnit": {
