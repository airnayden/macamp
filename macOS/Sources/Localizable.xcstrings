          }
        }
      }
    },
    "app.preferences.intelligence.mcp.consent.injection": {
      "comment": "Disclosure item: a tool result is untrusted text that can carry instructions (prompt injection)",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Резултатите идват от външна услуга и могат да съдържат инструкции, изглеждащи като ваши. Асистентът може да ги изпълни."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ergebnisse stammen von einem fremden Dienst und können Anweisungen enthalten, die wie deine aussehen. Der Assistent kann ihnen folgen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Results come from an outside service, and they can contain instructions written to look like yours. The assistant may follow them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los resultados vienen de un servicio externo y pueden contener instrucciones que parecen tuyas. El asistente puede seguirlas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les résultats proviennent d’un service externe et peuvent contenir des instructions qui semblent être les vôtres. L’assistant peut les suivre."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I risultati provengono da un servizio esterno e possono contenere istruzioni che sembrano tue. L’assistente potrebbe seguirle."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "Results come from an outside service, and they can contain instructions written to look like yours. The assistant may follow them."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результаты приходят от внешней службы и могут содержать инструкции, выглядящие как ваши. Ассистент может их выполнить."
          }
        }
      }
    },
    "app.preferences.intelligence.mcp.consent.lead": {
      "comment": "Lead sentence naming the external MCP server this disclosure is about",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не е част от MacAMP и MacAMP не може да провери какво връща."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gehört nicht zu MacAMP, und MacAMP kann nicht prüfen, was zurückkommt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is not part of MacAMP, and MacAMP cannot check what it sends back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no forma parte de MacAMP, y MacAMP no puede comprobar lo que devuelve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne fait pas partie de MacAMP, et MacAMP ne peut pas vérifier ce qu’il renvoie."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non fa parte di MacAMP e MacAMP non può verificare ciò che restituisce."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "%@ is not part of MacAMP, and MacAMP cannot check what it sends back."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ не является частью MacAMP, и MacAMP не может проверить, что он возвращает."
          }
        }
      }
    },
    "app.preferences.intelligence.mcp.consent.playback": {
      "comment": "Disclosure item: injected instructions can reach the playback-control tools",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Докато управлението на възпроизвеждането е включено, такива инструкции могат да пускат, променят или спират музиката ви."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Solange die Wiedergabesteuerung aktiv ist, können solche Anweisungen deine Musik starten, ändern oder stoppen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While playback control is on, instructions that arrive that way can start, change or stop your music."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mientras el control de reproducción esté activo, esas instrucciones pueden iniciar, cambiar o detener tu música."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tant que le contrôle de lecture est activé, ces instructions peuvent lancer, modifier ou arrêter votre musique."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finché il controllo di riproduzione è attivo, quelle istruzioni possono avviare, cambiare o fermare la tua musica."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "While playback control is on, instructions that arrive that way can start, change or stop your music."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока включено управление воспроизведением, такие инструкции могут запускать, менять или останавливать музыку."
          }
        }
      }
    },
    "app.preferences.intelligence.mcp.consent.process": {
      "comment": "Disclosure item: a stdio MCP server executes a local program with the user's own permissions",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Команден сървър изпълнява програма на този Mac с всичките ви права. MacAMP не е в пясъчник, така че тази програма може да чете и променя всичко, до което имате достъп."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Befehls-Server startet ein Programm auf diesem Mac mit deinen vollen Rechten. MacAMP läuft nicht in einer Sandbox, dieses Programm kann also alles lesen und ändern, was du kannst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A command server runs a program on this Mac with your full permissions. MacAMP is not sandboxed, so that program can read and change anything you can."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un servidor de comandos ejecuta un programa en este Mac con todos tus permisos. MacAMP no está en un entorno aislado, así que ese programa puede leer y cambiar todo lo que tú puedas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un serveur de commande exécute un programme sur ce Mac avec tous vos droits. MacAMP n’est pas en bac à sable : ce programme peut lire et modifier tout ce que vous pouvez."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un server a comando esegue un programma su questo Mac con tutti i tuoi permessi. MacAMP non è in sandbox, quindi quel programma può leggere e modificare tutto ciò che puoi tu."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "A command server runs a program on this Mac with your full permissions. MacAMP is not sandboxed, so that program can read and change anything you can."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Командный сервер запускает программу на этом Mac со всеми вашими правами. MacAMP не в песочнице, поэтому программа может читать и изменять всё, что доступно вам."
          }
        }
      }
    },
    "app.preferences.intelligence.mcp.consent.reversible": {
      "comment": "Note stating how to withdraw the grant this disclosure requests",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Можете да изключите този сървър по всяко време в Настройки ▸ Интелигентност."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst diesen Server jederzeit unter Einstellungen ▸ Intelligenz wieder ausschalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Switch this server off again at any time in Preferences ▸ Intelligence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes desactivar este servidor cuando quieras en Ajustes ▸ Inteligencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pouvez désactiver ce serveur à tout moment dans Réglages ▸ Intelligence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi disattivare questo server in qualsiasi momento in Impostazioni ▸ Intelligenza."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "Switch this server off again at any time in Preferences ▸ Intelligence."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы можете выключить этот сервер в любой момент в «Настройки ▸ Интеллект»."
          }
        }
      }
    },
    "app.preferences.intelligence.mcp.consent.review": {
      "comment": "Note stating which protections remain in force after this disclosure is accepted",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Промените в библиотеката ви пак изчакват одобрение в панела за преглед, а възпроизвеждането е обратимо."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Änderungen an deiner Mediathek warten weiterhin im Prüfdialog, und die Wiedergabe ist umkehrbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes to your library still wait for you in the review sheet, and playback is reversible."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios en tu biblioteca siguen esperándote en la hoja de revisión, y la reproducción es reversible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les modifications de votre bibliothèque vous attendent toujours dans la fiche de révision, et la lecture est réversible."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le modifiche alla libreria ti aspettano comunque nel foglio di revisione, e la riproduzione è reversibile."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "Changes to your library still wait for you in the review sheet, and playback is reversible."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изменения медиатеки по-прежнему ждут вашего подтверждения, а воспроизведение обратимо."
          }
        }
      }
    },
    "app.preferences.intelligence.mcp.consent.title": {
      "comment": "Title of the sheet shown before an external MCP server is enabled for the first time",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
