        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beschreibe einen Server für den Assistenten. Es wird nichts kontaktiert, bis du ihn aktivierst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe a server the assistant may call. Nothing is contacted until you enable it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe un servidor que el asistente pueda llamar. No se contacta nada hasta que lo actives."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décrivez un serveur que l’assistant peut appeler. Rien n’est contacté avant son activation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrivi un server che l’assistente può chiamare. Nulla viene contattato finché non lo attivi."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "Describe a server the assistant may call. Nothing is contacted until you enable it."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Опишите сервер для ассистента. Ничего не подключается, пока вы его не включите."
          }
        }
      }
    },
    "app.preferences.intelligence.mcp.caption": {
      "comment": "Caption explaining what an MCP server adds to the assistant",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "Позволете на асистента да ползва инструменти от други програми, отвъд вашата библиотека."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
