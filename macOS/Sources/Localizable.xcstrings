    "app.loudness.rescanConfirmMessage": {
      "comment": "Honest description of what a full loudness re-scan costs",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This discards every loudness value MacAMP has cached and decodes every audio file again. On a large library it can take a long time. You can pause or stop it at any point, and your music files are never changed."
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Това изтрива всички кеширани от MacAMP стойности за сила на звука и декодира отново всеки аудиофайл. При голяма библиотека може да отнеме много време. Можете да поставите процеса на пауза или да го спрете по всяко време. Музикалните ви файлове не се променят."
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Dabei werden alle von MacAMP gespeicherten Lautheitswerte verworfen und alle Audiodateien erneut dekodiert. Bei einer großen Mediathek kann das lange dauern. Du kannst den Vorgang jederzeit pausieren oder stoppen. Deine Musikdateien werden nicht verändert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Se descartarán todos los valores de volumen guardados por MacAMP y se volverá a decodificar cada archivo de audio. En una biblioteca grande puede tardar bastante. Puedes pausar o detener el proceso en cualquier momento; tus archivos de música no se modificarán."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Cette opération supprime toutes les valeurs de volume sonore mises en cache par MacAMP et décode à nouveau chaque fichier audio. Elle peut prendre beaucoup de temps avec une grande bibliothèque. Vous pouvez la mettre en pause ou l’arrêter à tout moment. Vos fichiers musicaux ne sont jamais modifiés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Verranno eliminati tutti i valori di volume memorizzati da MacAMP e ogni file audio verrà decodificato di nuovo. Con una libreria grande, l’operazione può richiedere molto tempo. Puoi sospenderla o interromperla in qualsiasi momento. I file musicali non vengono mai modificati."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Все сохранённые MacAMP значения громкости будут удалены, а каждый аудиофайл — декодирован заново. Для большой медиатеки это может занять много времени. Процесс можно приостановить или остановить в любой момент. Музыкальные файлы не изменяются."
          }
        }
      }
    },
    "app.loudness.rescanConfirmTitle": {
      "comment": "Title of the confirmation asked before a full loudness re-scan",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure your whole library again?"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Да се измери ли отново цялата библиотека?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Gesamte Mediathek erneut messen?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "needs_review",
            "value": "¿Volver a medir toda la biblioteca?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Mesurer à nouveau toute la bibliothèque ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Misurare di nuovo l’intera libreria?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Повторно измерить всю медиатеку?"
          }
        }
      }
    },
    "app.loudness.rescanHelp": {
      "comment": "Tooltip on the Re-scan Library button",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Measure every track again, in case something was missed"
          }
        },
        "bg": {
          "stringUnit": {
            "state": "needs_review",
            "value": "Повторно измерване на всички записи, в случай че нещо е пропуснато"
          }
        },
        "de": {
