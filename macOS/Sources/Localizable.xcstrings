    "app.assistant.preview.failureTagWrite": {
      "comment": "Shown when a tag write failed part-way through a batch",
      "extractionState": "manual",
      "localizations": {
        "bg": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP не можа да запише етикетите. По-ранните файлове може вече да са обновени — повторното прилагане е безопасно."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP konnte die Tags nicht schreiben. Frühere Dateien sind vielleicht schon aktualisiert – erneutes Anwenden ist sicher."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP couldn't write the tags. Files earlier in the batch may already be updated — applying again is safe."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP no ha podido escribir las etiquetas. Puede que los primeros archivos ya estén actualizados: volver a aplicar es seguro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP n’a pas pu écrire les tags. Les premiers fichiers sont peut-être déjà à jour — réappliquer est sans risque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP non è riuscito a scrivere i tag. I primi file potrebbero già essere aggiornati: riapplicare è sicuro."
          }
        },
        "pseudo": {
          "stringUnit": {
            "state": "new",
            "value": "MacAMP couldn't write the tags. Files earlier in the batch may already be updated — applying again is safe."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "MacAMP не смог записать теги. Файлы в начале пакета могут быть уже обновлены — повторное применение безопасно."
          }
        }
      }
    },
    "app.assistant.preview.failureUnexpected": {
      "comment": "Shown when applying failed with an error the assistant does not classify",
